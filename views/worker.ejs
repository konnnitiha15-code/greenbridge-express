async function sendActive() {
  const inp = document.getElementById('active-inp');
  const txt = inp.value.trim();
  if(!txt || !ACTIVE_CHAT) return;
  const btn = document.getElementById('active-send');
  inp.value=''; inp.style.height='auto'; btn.disabled=true;
  const time = new Date().toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'});

  if (ACTIVE_CHAT.isGroup) {
    // Group: 翻訳してDBに保存
    const grp = GROUPS.find(g=>g.id===ACTIVE_CHAT.id);
    const m = {t:'me', txt, time};
    if (grp) grp.msgs.push(m);
    addActiveBubble(m, true);
    try {
      const jp = await aiTx(txt, 'ja');
      if(grp){grp.prev='あなた: '+txt.slice(0,20);grp.unread=0;}
      // グループDBに保存
      const res = await fetch(`/worker/api/groups/${ACTIVE_CHAT.id}/messages`,{
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({body: txt, translated: jp})
      });
      const json = await res.json();
      if(json.ok && json.message){
        _wGroupMsgLastTs[ACTIVE_CHAT.id] = json.message.created_at;
        toast('送信完了','グループに送信しました');
      } else {
        toast('送信エラー', json.error||'送信に失敗しました', 'r');
      }
    } catch(e) { toast('翻訳エラー',e.message,'r'); }
  } else {
    // Direct: translate and send to supervisor
    addActiveBubble({t:'me',txt,time}, true);
    const tid='typ-'+Date.now();
    const area=document.getElementById('active-msgs');
    const tr=document.createElement('div');tr.id=tid;tr.className='mrow';
    tr.innerHTML='<div class="mav" style="background:var(--gbg);color:var(--gn)">田</div><div style="display:flex;gap:4px;align-items:center;padding:9px 13px;background:#fff;border-radius:4px 16px 16px 16px"><span style="width:7px;height:7px;border-radius:50%;background:var(--t3);animation:td 1.3s infinite;display:inline-block"></span><span style="width:7px;height:7px;border-radius:50%;background:var(--t3);animation:td 1.3s .2s infinite;display:inline-block"></span><span style="width:7px;height:7px;border-radius:50%;background:var(--t3);animation:td 1.3s .4s infinite;display:inline-block"></span></div>';
    area.appendChild(tr);area.scrollTop=area.scrollHeight;
    try {
      const jp = await aiTx(txt, 'ja');
      document.getElementById(tid)?.remove();
      const m = {t:'me', txt, tl:jp, time, is_read:false};
      const dm = DM_CHATS.find(d=>d.id===ACTIVE_CHAT?.id);
      if(dm) dm.msgs.push(m);
      addActiveBubble(m, true);
      // DB に保存（receiver は ACTIVE_CHAT の相手）
      const rcv = ACTIVE_CHAT?.contactId || null;
      try{
        const sendRes = await fetch('/worker/api/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({body:txt,translated:jp,receiver_id:rcv})});
        const sendJson = await sendRes.json();
        if(sendJson.ok && sendJson.message) m._id = sendJson.message.id;
      }catch(e){ console.warn('[msg]',e); toast('送信エラー','メッセージの送信に失敗しました','r'); }
      toast('✓','担当者に送信しました');
    } catch(e) {
      document.getElementById(tid)?.remove();
      toast('翻訳エラー',e.message,'r');
    }
  }
  btn.disabled=false;
}

// ── DOCUMENTS ─────────────────────────────────────────────────────────────────
async function openDoc(key){
  // W_DOCS から書類情報を取得
  const docInfo = W_DOCS.find(d=>d.id===key);
  currentDoc=key;const L=LS[LANG]||LS.vi;
  // タイトル設定
  const titleEl = document.getElementById('dd-title');
  if(titleEl) titleEl.textContent = docInfo?.name || (L.docNames?.[key]||key);
  // 期限情報表示
  const metaBar = document.getElementById('dd-meta-bar');
  if(metaBar && docInfo){
    const now = new Date();
    let metaHtml = '';
    if(docInfo.expireDate){
      const diff=(new Date(docInfo.expireDate)-now)/(1000*60*60*24);
      if(diff<0) metaHtml=`<div style="background:var(--rbg);border:1px solid #fca5a5;border-radius:8px;padding:8px 12px;font-size:12.5px;color:var(--red)">⚠ 期限切れ: ${docInfo.expireDate}</div>`;
      else if(diff<=7) metaHtml=`<div style="background:var(--abg);border:1px solid #fcd34d;border-radius:8px;padding:8px 12px;font-size:12.5px;color:var(--amb)">⏰ 期限まであと${Math.ceil(diff)}日（${docInfo.expireDate}）</div>`;
    }
    if(docInfo.fileName){
      const sizeKB = docInfo.fileSize ? Math.round(docInfo.fileSize/1024) : 0;
      metaHtml += `<div style="background:var(--bbg);border:1px solid #93c5fd;border-radius:8px;padding:10px 12px;font-size:12.5px;color:var(--blu);display:flex;align-items:center;gap:10px;margin-top:8px">
        <div style="flex:1;min-width:0">
          <div style="font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">📎 ${docInfo.fileName}</div>
          ${sizeKB?`<div style="font-size:11px;color:var(--t3);margin-top:2px">${sizeKB} KB</div>`:''}
        </div>
        <button onclick="openDocFile('${key}')" style="background:var(--blu);color:#fff;border:none;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:700;cursor:pointer">開く</button>
      </div>`;
    }
    metaBar.innerHTML = metaHtml;
    metaBar.style.display = metaHtml ? '' : 'none';
  }
  ttsStop();document.getElementById('ddover').classList.add('on');
  const bodyEl=document.getElementById('dd-body');
  const trLbl=document.getElementById('tr-status-lbl');
  if(LANG!=='ja'){
    const cacheKey=key+'-'+LANG;
    if(docTranslateCache[cacheKey]){bodyEl.textContent=docTranslateCache[cacheKey];trLbl.textContent='🌐 '+L.lLabel+'に翻訳済み';}
    else{bodyEl.innerHTML='<span style="color:#9ca3af">翻訳中... ⏳</span>';trLbl.textContent='';
      try{const translated=await aiTx(DOC_CONTENT[key]||'',LANG);docTranslateCache[cacheKey]=translated;bodyEl.textContent=translated;trLbl.textContent='🌐 '+L.lLabel+'に翻訳済み';}
      catch(e){bodyEl.textContent=DOC_CONTENT[key]||'';trLbl.textContent='⚠ 翻訳エラー（日本語で表示）';}
    }
  }else{bodyEl.textContent=DOC_CONTENT[key]||'';trLbl.textContent='';}
  const done=confirmedDocs.has(key);const cbox=document.getElementById('cbox');
  cbox.style.display='';cbox.className='cbox'+(done?' done':'');
  if(done){cbox.innerHTML=`<div style="font-size:14px;font-weight:700;color:var(--gn)">✓ ${L.understood}</div><div style="font-size:12px;color:var(--gn);margin-top:4px">${new Date().toLocaleDateString('ja-JP')}</div>`;}
  else{cbox.innerHTML=`<div style="font-size:14px;font-weight:700;color:var(--gn);margin-bottom:12px">${L.confirmQ}</div><button class="btn btn-g" onclick="confirmDoc()" style="padding:12px"><span>✓ ${L.understood}</span></button>`;}
}
function closeDoc(){document.getElementById('ddover').classList.remove('on');ttsStop();}

// 書類ファイルを開く（署名URLを再生成して新規タブで表示）
async function openDocFile(docId){
  try{
    const res  = await fetch(`/worker/api/documents/${docId}/url`);
    const json = await res.json();
    if(!json.ok || !json.url){
      toast('エラー', json.error || 'ファイルを開けませんでした', 'r');
      return;
    }
    window.open(json.url, '_blank');
  }catch(e){
    toast('エラー', 'ネットワークエラー', 'r');
  }
}
function confirmDoc(){
  if(!currentDoc)return;confirmedDocs.add(currentDoc);const L=LS[LANG]||LS.vi;
  const cbox=document.getElementById('cbox');cbox.className='cbox done';
  cbox.innerHTML=`<div style="font-size:14px;font-weight:700;color:var(--gn)">✓ ${L.understood}</div><div style="font-size:12px;color:var(--gn);margin-top:4px">${new Date().toLocaleDateString('ja-JP')}</div>`;
  const b=document.getElementById('db-'+currentDoc);if(b){b.className='badge bg';b.textContent='確認済';}
  // 書類確認を通知
  fetch('/worker/api/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({body:'書類確認完了: '+currentDoc,translated:'書類確認完了: '+currentDoc})}).catch(e=>{console.warn('[msg]',e);});
  toast('✓ 確認完了','書類を確認しました');updateProg();
}
function updateProg(){

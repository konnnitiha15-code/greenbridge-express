<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<meta name="theme-color" content="#00b050">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="GB Worker">
<title>GreenBridge</title>
<link rel="manifest" href="/manifest-worker.json">
<link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
<link rel="apple-touch-icon" href="/icons/icon.svg">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════
   TOKENS
═══════════════════════════════════ */
:root{
  --bg:#f0f2f6;
  --white:#ffffff;
  --bd:#d8dce6;        /* 枠線 — しっかり見える */
  --bd2:#b8bece;       /* 強調枠線 */
  --tx:#0d1117;
  --t2:#4a5568;
  --t3:#8a94a8;
  --gn:#00b050;
  --gd:#009040;
  --gbg:#e6f9f0;
  --glt:#99e5c0;
  --red:#e53e3e;
  --rbg:#fff0f0;
  --amb:#d97706;
  --abg:#fffbeb;
  --blu:#2563eb;
  --bbg:#eff6ff;
  --me:#d4f5e2;
  --r:12px;
  --r2:16px;
  --nav:62px;
}
/* ═══════════════════════════════════
   RESET
═══════════════════════════════════ */
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;font-size:14px}
body{font-family:'Noto Sans JP',sans-serif;background:var(--bg);color:var(--tx);
     display:flex;flex-direction:column;max-width:430px;margin:0 auto;height:100dvh}
input,textarea,select,button{font-family:inherit}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:4px}

/* ═══════════════════════════════════
   STATUSBAR
═══════════════════════════════════ */
.sbar{
  background:var(--white);
  border-bottom:1.5px solid var(--bd);
  padding:10px 18px 6px;
  display:flex;justify-content:space-between;align-items:center;
  flex-shrink:0;
}
.stime{font-size:15px;font-weight:600}
.sbar-r{display:flex;gap:4px;align-items:center;color:var(--t3)}

/* ═══════════════════════════════════
   SCREENS
═══════════════════════════════════ */
.screens{flex:1;position:relative;overflow:hidden}
.scr{position:absolute;inset:0;display:none;flex-direction:column;overflow:hidden;background:var(--bg)}
.scr.on{display:flex}

/* ═══════════════════════════════════
   PAGE HEADER
═══════════════════════════════════ */
.pg-top{
  background:var(--white);
  border-bottom:2px solid var(--bd);
  padding:13px 18px;
  display:flex;align-items:center;justify-content:space-between;
  flex-shrink:0;
}
.pg-title{font-size:18px;font-weight:700;letter-spacing:-.3px}
.pg-sub{font-size:12px;color:var(--t3);margin-top:2px}

/* ═══════════════════════════════════
   SCROLL
═══════════════════════════════════ */
.scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch}
.scroll.pb{padding-bottom:var(--nav)}

/* ═══════════════════════════════════
   CARD  ← 枠線が核心
═══════════════════════════════════ */
.card{
  background:var(--white);
  border-radius:var(--r2);
  border:1.5px solid var(--bd);   /* ← 見える枠 */
  overflow:hidden;
  margin-bottom:12px;
}
.card-hdr{
  padding:12px 15px;
  border-bottom:1.5px solid var(--bd);
  display:flex;align-items:center;justify-content:space-between;
  background:#fafbfd;
}
.card-title{font-size:13.5px;font-weight:700}
.card-row{
  padding:12px 15px;
  border-bottom:1.5px solid var(--bd);
  display:flex;align-items:center;gap:12px;
}
.card-row:last-child{border-bottom:none}
.card-row.tap{cursor:pointer;transition:background .1s}
.card-row.tap:active{background:#f5f8ff}

/* ═══════════════════════════════════
   BADGE
═══════════════════════════════════ */
.bdg{display:inline-flex;align-items:center;font-size:11px;padding:3px 9px;border-radius:99px;font-weight:600;border:1px solid transparent}
.bg{background:var(--gbg);color:var(--gn);border-color:var(--glt)}
.ba{background:var(--abg);color:var(--amb);border-color:#fcd34d}
.br{background:var(--rbg);color:var(--red);border-color:#fca5a5}
.bb{background:var(--bbg);color:var(--blu);border-color:#93c5fd}
.bgr{background:#f0f2f6;color:var(--t2);border-color:var(--bd)}

/* ═══════════════════════════════════
   BUTTON
═══════════════════════════════════ */
.btn{width:100%;padding:13px;border:2px solid transparent;border-radius:var(--r);
     font-size:14px;font-weight:700;cursor:pointer;
     display:flex;align-items:center;justify-content:center;gap:9px;
     font-family:inherit;transition:all .14s}
.btn:active{transform:scale(.97)}
.btn-g{background:var(--gn);color:#fff;border-color:var(--gd)}
.btn-g:hover{background:var(--gd)}
.btn-b{background:var(--bbg);color:var(--blu);border-color:#93c5fd}
.btn-r{background:var(--rbg);color:var(--red);border-color:#fca5a5}
.btn-ghost{background:var(--white);color:var(--t2);border:2px solid var(--bd)}
.btn-sm{width:auto;padding:6px 14px;font-size:12.5px;border-radius:9px}
.btn-xs{width:auto;padding:4px 11px;font-size:12px;border-radius:8px;
        border:1.5px solid var(--bd);background:var(--white);color:var(--t2);cursor:pointer;font-family:inherit}

/* ═══════════════════════════════════
   FORM INPUTS
═══════════════════════════════════ */
.finp{width:100%;padding:11px 13px;border:2px solid var(--bd);border-radius:10px;
      font-size:13.5px;font-family:inherit;color:var(--tx);background:#fafbfd;
      outline:none;transition:border-color .15s;resize:none;line-height:1.6}
.finp:focus{border-color:var(--gn);background:var(--white)}
.flbl{font-size:11.5px;font-weight:700;color:var(--t2);text-transform:uppercase;
      letter-spacing:.05em;margin-bottom:5px;display:block}

/* ═══════════════════════════════════
   FILTER CHIPS
═══════════════════════════════════ */
.chips{display:flex;gap:7px;overflow-x:auto;scrollbar-width:none;padding:12px 16px}
.chips::-webkit-scrollbar{display:none}
.chip{padding:6px 14px;border-radius:99px;font-size:12.5px;font-weight:600;
      border:1.5px solid var(--bd);background:var(--white);color:var(--t2);
      cursor:pointer;white-space:nowrap;transition:all .12s}
.chip.on{background:var(--gbg);color:var(--gn);border-color:var(--glt)}

/* ═══════════════════════════════════
   PULSE
═══════════════════════════════════ */
.pulse{width:6px;height:6px;border-radius:50%;background:var(--gn);
       animation:pulse 2s infinite;display:inline-block}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}

/* ═══════════════════════════════════
   ── HOME ──
═══════════════════════════════════ */
.hero{
  background:var(--gn);
  border-bottom:2px solid var(--gd);
  padding:18px 18px 20px;
  flex-shrink:0;
}
.hero-name{font-size:21px;font-weight:700;color:#fff;letter-spacing:-.3px}
.hero-sub{font-size:12.5px;color:rgba(255,255,255,.8);margin-top:3px}
.hero-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.hstat{
  background:rgba(255,255,255,.18);
  border:1.5px solid rgba(255,255,255,.35);
  border-radius:12px;padding:11px 13px;
}
.hstat-val{font-size:21px;font-weight:700;color:#fff;line-height:1}
.hstat-lbl{font-size:11.5px;color:rgba(255,255,255,.8);margin-top:4px}

/* Quick access */
.qa-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:14px 14px 4px}
.qa-item{display:flex;flex-direction:column;align-items:center;gap:6px;
         cursor:pointer;padding:4px 2px;transition:transform .14s}
.qa-item:active{transform:scale(.9)}
.qa-ico{
  width:52px;height:52px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;font-size:22px;
  border:2px solid var(--bd);           /* ← アイコン枠 */
  background:var(--white);
  box-shadow:0 1px 4px rgba(0,0,0,.08);
}
.qa-lbl{font-size:10.5px;font-weight:600;color:var(--t2);text-align:center;line-height:1.3}

/* Notice rows */
.n-ico{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;
       justify-content:center;font-size:17px;flex-shrink:0;border:1.5px solid var(--bd)}
.n-body{flex:1;min-width:0}
.n-title{font-size:13px;font-weight:600}
.n-sub{font-size:11.5px;color:var(--t3);margin-top:2px}
.n-arr{font-size:18px;color:var(--bd2)}

/* SOS strip */
.sos-strip{
  margin:4px 14px 14px;
  background:var(--red);
  border:2px solid #c92a2a;
  border-radius:var(--r2);
  padding:13px 16px;
  display:flex;align-items:center;gap:12px;
  cursor:pointer;transition:transform .14s;
}
.sos-strip:active{transform:scale(.97)}
.sos-strip-lbl{font-size:15px;font-weight:700;color:#fff}
.sos-strip-sub{font-size:11.5px;color:rgba(255,255,255,.8);margin-top:2px}

/* ═══════════════════════════════════
   ── CHAT ──
═══════════════════════════════════ */
#s-chat{flex-direction:row}
.cl-panel{
  width:115px;
  background:var(--white);
  border-right:2px solid var(--bd);
  display:flex;flex-direction:column;flex-shrink:0;
}
.clp-top{
  padding:10px 8px 7px;
  border-bottom:1.5px solid var(--bd);
  display:flex;align-items:center;justify-content:space-between;
  background:#fafbfd;
}
.clp-title{font-size:11.5px;font-weight:700}
.cl-add{
  width:24px;height:24px;border-radius:7px;
  background:var(--gbg);border:1.5px solid var(--glt);
  color:var(--gn);font-size:16px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;line-height:1;
}
.cl-sec{
  font-size:9.5px;font-weight:700;color:var(--t3);
  text-transform:uppercase;letter-spacing:.08em;
  padding:7px 8px 3px;
  background:#f7f9fc;
  border-bottom:1px solid var(--bd);
}
.cl-items{flex:1;overflow-y:auto}
.cl-item{
  display:flex;flex-direction:column;align-items:center;
  padding:10px 5px;gap:5px;
  border-bottom:1.5px solid var(--bd);
  cursor:pointer;transition:background .1s;position:relative;
}
.cl-item:hover{background:#f5fffe}
.cl-item.on{background:var(--gbg)}
.cl-av{
  width:40px;height:40px;border-radius:50%;
  border:2px solid var(--bd);           /* ← アバター枠 */
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:700;flex-shrink:0;position:relative;
}
.cl-av.grp{border-radius:11px}
.cl-dot{position:absolute;bottom:0;right:0;width:10px;height:10px;
        border-radius:50%;border:2px solid var(--white)}
.cl-name{font-size:10px;font-weight:600;color:var(--t2);text-align:center;line-height:1.3}
.cl-item.on .cl-name{color:var(--gn)}
.cl-unread{
  position:absolute;top:5px;right:5px;
  background:var(--red);color:#fff;font-size:9px;font-weight:700;
  min-width:15px;height:15px;border-radius:8px;
  padding:0 3px;display:flex;align-items:center;justify-content:center;
}

/* Chat window */
.chat-wall{flex:1;display:flex;flex-direction:column;overflow:hidden}
.chat-welcome{
  flex:1;display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  gap:12px;padding:24px;text-align:center;
  border-left:2px solid var(--bd);
}
.chat-welcome svg{opacity:.25}
.cw-title{font-size:15px;font-weight:700;color:var(--t2)}
.cw-sub{font-size:12.5px;color:var(--t3);line-height:1.6}
.chat-pane{flex:1;display:none;flex-direction:column;overflow:hidden}
.chat-hdr{
  background:var(--white);
  border-bottom:2px solid var(--bd);
  padding:10px 14px;
  display:flex;align-items:center;gap:10px;flex-shrink:0;
}
.ch-av{
  width:36px;height:36px;border-radius:50%;
  border:2px solid var(--bd);
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:700;flex-shrink:0;
}
.ch-name{font-size:14px;font-weight:700}
.ch-sub{font-size:11px;color:var(--t3);margin-top:1px}

/* Messages */
.msgs{flex:1;overflow-y:auto;padding:10px 11px;
      display:flex;flex-direction:column;gap:3px;background:#e5e9f0}
.sys-msg{align-self:center;background:rgba(0,0,0,.1);color:rgba(0,0,0,.5);
         font-size:11.5px;padding:3px 12px;border-radius:10px;margin:4px 0;font-weight:500}
.mrow{display:flex;gap:7px;max-width:82%}
.mrow.r{align-self:flex-end;flex-direction:row-reverse}
.mav{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--bd);
     display:flex;align-items:center;justify-content:center;
     font-size:9px;font-weight:700;flex-shrink:0;align-self:flex-end}
.mcol{display:flex;flex-direction:column;gap:2px}
.msender{font-size:10.5px;color:var(--t2);padding:0 4px;margin-bottom:1px;font-weight:600}
.bub{padding:9px 13px;font-size:13.5px;line-height:1.6;word-break:break-word}
.bub.other{
  background:var(--white);
  border:1.5px solid var(--bd);        /* ← 吹き出し枠 */
  border-radius:4px 16px 16px 16px;
}
.bub.me{
  background:var(--me);
  border:1.5px solid #7dd8aa;          /* ← 自分の吹き出し枠 */
  border-radius:16px 16px 4px 16px;
}
.bub.ai{
  background:#e8f9f0;
  border:1.5px solid var(--glt);       /* ← AI吹き出し枠 */
  border-radius:4px 16px 16px 16px;
  font-size:12.5px;color:#065f46;
}
.ai-lbl{display:block;font-size:10px;font-weight:700;color:var(--gn);margin-bottom:2px;opacity:.8}
.mtime{font-size:10px;color:rgba(0,0,0,.3);padding:0 4px;align-self:flex-end}

/* Typing */
.typing-r{display:flex;gap:7px;align-items:flex-end}
.typing-b{display:flex;gap:4px;align-items:center;padding:9px 13px;
          background:var(--white);border:1.5px solid var(--bd);
          border-radius:4px 16px 16px 16px;}
.typing-b span{width:6px;height:6px;border-radius:50%;background:var(--t3);animation:td 1.3s infinite}
.typing-b span:nth-child(2){animation-delay:.2s}
.typing-b span:nth-child(3){animation-delay:.4s}
@keyframes td{0%,100%{opacity:.3;transform:translateY(0)}50%{opacity:1;transform:translateY(-3px)}}

/* Quick replies */
.qrow{
  display:flex;gap:6px;padding:7px 10px;overflow-x:auto;scrollbar-width:none;
  background:var(--white);border-bottom:1.5px solid var(--bd);flex-shrink:0;
}
.qrow::-webkit-scrollbar{display:none}
.qbtn{padding:5px 12px;border-radius:99px;font-size:12px;font-weight:600;
      border:1.5px solid var(--bd);background:var(--white);color:var(--t2);
      cursor:pointer;white-space:nowrap;transition:all .12s}
.qbtn:active{background:var(--gbg);color:var(--gn);border-color:var(--glt)}

/* Chat input bar */
.cinp-bar{
  background:var(--white);border-top:2px solid var(--bd);
  padding:9px 11px;display:flex;gap:8px;align-items:flex-end;flex-shrink:0;
}
.cinp{
  flex:1;padding:10px 13px;
  border:2px solid var(--bd);          /* ← 入力枠 */
  border-radius:22px;font-size:13.5px;font-family:inherit;
  background:#f8f9fc;color:var(--tx);
  outline:none;resize:none;max-height:100px;line-height:1.45;
  transition:border-color .15s;
}
.cinp:focus{border-color:var(--gn);background:var(--white)}
.csend{
  width:40px;height:40px;border-radius:50%;
  background:var(--gn);border:2px solid var(--gd);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;transition:all .14s;
}
.csend:active{transform:scale(.92)}
.csend:disabled{opacity:.4;cursor:not-allowed}

/* ═══════════════════════════════════
   ── DOCS overlay ──
═══════════════════════════════════ */
.overlay{position:absolute;inset:0;z-index:80;display:none;flex-direction:column;
         overflow:hidden;background:var(--bg)}
.overlay.on{display:flex}
.ov-hdr{
  background:var(--white);border-bottom:2px solid var(--bd);
  padding:11px 15px;display:flex;align-items:center;gap:10px;flex-shrink:0;
}
.back-btn{
  padding:6px 13px;border-radius:99px;
  border:1.5px solid var(--bd);background:var(--white);
  font-size:13px;cursor:pointer;font-family:inherit;color:var(--t2);font-weight:500;
}
.back-btn:active{background:var(--bg)}
.ov-scroll{flex:1;overflow-y:auto;padding:13px;display:flex;flex-direction:column;gap:10px}

/* TTS bar */
.tts-bar{
  background:var(--white);border:2px solid var(--bd);border-radius:var(--r);
  padding:11px 13px;display:flex;align-items:center;gap:10px;
}
.tts-play{
  width:36px;height:36px;border-radius:50%;
  background:var(--gn);border:2px solid var(--gd);
  cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.tts-prog{flex:1;height:5px;background:#e5e9f0;border-radius:99px;overflow:hidden}
.tts-fill{height:100%;background:var(--gn);border-radius:99px;width:0%;transition:width .3s}

.doc-body-box{
  background:var(--white);border:2px solid var(--bd);
  border-radius:var(--r);padding:15px;
  font-size:13.5px;line-height:1.9;color:var(--tx);white-space:pre-wrap;
}
.confirm-box{
  background:var(--gbg);border:2px solid var(--glt);
  border-radius:var(--r);padding:15px;
}

/* ═══════════════════════════════════
   ── TEMPLATES ──
═══════════════════════════════════ */
.tpl-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:13px}
.tpl-card{
  background:var(--white);
  border:2px solid var(--bd);          /* ← テンプレートカード枠 */
  border-radius:var(--r2);
  padding:15px 10px;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:7px;text-align:center;
  transition:all .14s;
}
.tpl-card:active{transform:scale(.95);border-color:var(--glt);background:var(--gbg)}
.tpl-ico{
  width:46px;height:46px;border-radius:13px;
  border:1.5px solid var(--bd);
  display:flex;align-items:center;justify-content:center;font-size:22px;
}
.tpl-name{font-size:13px;font-weight:700;line-height:1.3}
.tpl-sub{font-size:11px;color:var(--t3)}
.tpl-form{
  background:var(--white);border:2px solid var(--bd);
  border-radius:var(--r2);margin:0 13px 13px;padding:15px;
  display:none;flex-direction:column;gap:11px;
}
.tpl-form.on{display:flex}
.result-box{
  background:var(--gbg);border:2px solid var(--glt);
  border-radius:var(--r);padding:13px;
  font-size:13.5px;color:#065f46;line-height:1.7;display:none;white-space:pre-wrap;
}
.result-box.on{display:block}

/* ═══════════════════════════════════
   ── VIDEOS ──
═══════════════════════════════════ */
.vid-row{
  background:var(--white);border:2px solid var(--bd);
  border-radius:var(--r);padding:12px;
  display:flex;gap:12px;align-items:center;cursor:pointer;
  transition:all .14s;margin-bottom:8px;
}
.vid-row:active{transform:scale(.98);border-color:var(--glt)}
.vid-thumb{
  width:70px;height:46px;border-radius:9px;
  background:#1a1d2e;border:2px solid #2d3148;
  display:flex;align-items:center;justify-content:center;
  font-size:22px;flex-shrink:0;position:relative;overflow:hidden;
}
.vid-dur{position:absolute;bottom:3px;right:4px;background:rgba(0,0,0,.75);
         color:#fff;font-size:9px;padding:1px 4px;border-radius:3px;font-family:monospace}
.vid-title{font-size:13px;font-weight:600;line-height:1.4}
.vid-info{font-size:11.5px;color:var(--t2);margin-top:3px}
.vid-watched{font-size:11px;color:var(--gn);font-weight:700;margin-top:3px}
.vid-player{
  background:#1a1d2e;aspect-ratio:16/9;
  border-bottom:2px solid var(--bd);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;position:relative;flex-shrink:0;
}
.play-circle{
  width:56px;height:56px;border-radius:50%;
  background:rgba(255,255,255,.12);border:2px solid rgba(255,255,255,.5);
  display:flex;align-items:center;justify-content:center;transition:all .2s;
}
.vid-player:active .play-circle{transform:scale(1.08);background:rgba(255,255,255,.22)}

/* ═══════════════════════════════════
   ── NIPPO ──
═══════════════════════════════════ */
.np-row{
  background:var(--white);border:2px solid var(--bd);
  border-radius:var(--r);padding:13px;cursor:pointer;
  transition:all .14s;margin-bottom:8px;
}
.np-row:active{transform:scale(.98);border-color:var(--glt)}
.np-date{font-size:13px;font-weight:700}
.np-prev{font-size:12.5px;color:var(--t2);line-height:1.5;
         white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:4px}

/* ═══════════════════════════════════
   ── SHIFT ──
═══════════════════════════════════ */
.shift-days{
  display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;
  padding:13px 13px 4px;flex-shrink:0;
}
.shift-days::-webkit-scrollbar{display:none}
.sday{
  flex-shrink:0;width:78px;
  background:var(--white);border:2px solid var(--bd);  /* ← シフト枠 */
  border-radius:var(--r);padding:11px 7px;text-align:center;
  transition:border-color .14s;
}
.sday.today{border-color:var(--gn);border-width:2.5px;background:var(--gbg)}
.sday-dw{font-size:11px;color:var(--t3);margin-bottom:2px}
.sday-date{font-size:18px;font-weight:700;margin-bottom:6px}
.sday.today .sday-dw,.sday.today .sday-date{color:var(--gn)}
.sday-label{font-size:11.5px;font-weight:700;padding:4px 2px;border-radius:7px}

.shift-card{
  background:var(--white);border:2px solid var(--bd);
  border-radius:var(--r2);margin:10px 13px 0;padding:15px;
}
.shift-card-title{font-size:14px;font-weight:700;margin-bottom:12px}
.shift-hist{
  background:var(--white);border:2px solid var(--bd);
  border-radius:var(--r2);margin:10px 13px 14px;overflow:hidden;
}
.sh-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:11px 13px;border-bottom:1.5px solid var(--bd);
}
.sh-row:last-child{border-bottom:none}
.sh-main{font-size:13px;font-weight:600}
.sh-date{font-size:11.5px;color:var(--t3);margin-top:2px}

/* ═══════════════════════════════════
   ── SOS ──
═══════════════════════════════════ */
.sos-page{flex:1;display:flex;flex-direction:column;align-items:center;
          justify-content:flex-start;gap:15px;padding:22px 18px}
.sos-desc{font-size:13.5px;color:var(--t2);text-align:center;line-height:1.7}
.sos-ring{
  width:136px;height:136px;border-radius:50%;
  background:var(--white);
  border:4px solid var(--red);          /* ← SOSボタン枠 */
  box-shadow:0 0 0 6px var(--rbg);
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  cursor:pointer;user-select:none;transition:all .15s;
}
.sos-ring.pressing{transform:scale(.93);background:var(--rbg)}
.sos-ring-label{font-size:16px;font-weight:700;color:var(--red);margin-top:5px}
.sos-cnt{font-size:52px;font-weight:300;color:var(--red)}
.sos-ok{
  width:100%;background:var(--gbg);border:2px solid var(--glt);
  border-radius:var(--r2);padding:16px;text-align:center;
}
.sos-ok-title{font-size:17px;font-weight:700;color:var(--gn)}
.contact-card{
  width:100%;background:var(--white);border:2px solid var(--bd);
  border-radius:var(--r);padding:13px;display:flex;gap:12px;align-items:center;
}
.cc-ico{width:40px;height:40px;border-radius:50%;background:var(--rbg);
        border:2px solid #fca5a5;display:flex;align-items:center;justify-content:center;
        font-size:18px;flex-shrink:0}

/* ═══════════════════════════════════
   ── SETTINGS ──
═══════════════════════════════════ */
.profile-hdr{
  background:var(--gn);border-bottom:2px solid var(--gd);
  padding:18px;display:flex;align-items:center;gap:14px;flex-shrink:0;
}
.pav{width:52px;height:52px;border-radius:50%;
     background:rgba(255,255,255,.2);border:2px solid rgba(255,255,255,.5);
     display:flex;align-items:center;justify-content:center;
     font-size:18px;font-weight:700;color:#fff;flex-shrink:0}
.pname{font-size:16px;font-weight:700;color:#fff;letter-spacing:-.2px}
.psub{font-size:12px;color:rgba(255,255,255,.8);margin-top:2px}
.pbdg{display:inline-flex;align-items:center;margin-top:7px;
      background:rgba(255,255,255,.2);border:1.5px solid rgba(255,255,255,.4);
      color:#fff;font-size:11.5px;padding:3px 10px;border-radius:99px;font-weight:600}

.ss-section{
  background:var(--white);border:2px solid var(--bd);  /* ← 設定セクション枠 */
  border-radius:var(--r2);margin:0 13px 12px;overflow:hidden;
}
.ss-hdr{padding:12px 14px;border-bottom:1.5px solid var(--bd);background:#fafbfd}
.ss-hdr-title{font-size:13.5px;font-weight:700}
.ss-hdr-sub{font-size:11.5px;color:var(--t3);margin-top:2px}
.ss-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:13px 14px;border-bottom:1.5px solid var(--bd);gap:12px;
}
.ss-row:last-child{border-bottom:none}
.ss-l{flex:1;min-width:0}
.ss-lbl{font-size:13.5px;font-weight:500}
.ss-desc{font-size:12px;color:var(--t3);margin-top:2px}
.ss-val{font-size:13px;color:var(--t2)}
.tgl{
  width:44px;height:26px;border-radius:13px;
  position:relative;cursor:pointer;flex-shrink:0;
  transition:background .2s;border:2px solid transparent;outline:none;
}
.tgl::after{
  content:'';position:absolute;
  width:18px;height:18px;border-radius:50%;background:#fff;
  top:2px;right:2px;transition:right .15s;
  box-shadow:0 1px 4px rgba(0,0,0,.25);
}
.tgl.on{background:var(--gn);border-color:var(--gd)}
.tgl.off{background:#c0c8d8;border-color:#a0a8b8}
.tgl.off::after{right:22px}

.lang-opt{
  display:flex;align-items:center;gap:12px;
  padding:12px 14px;border-bottom:1.5px solid var(--bd);
  cursor:pointer;transition:background .1s;
}
.lang-opt:last-child{border-bottom:none}
.lang-opt:active{background:var(--gbg)}
.lang-opt.sel{background:#f0fdf5}
.lang-check{margin-left:auto;color:var(--gn);font-size:18px}
.lang-name{font-size:13.5px;font-weight:600}
.lang-native{font-size:11.5px;color:var(--t3);margin-top:1px}

/* ═══════════════════════════════════
   ── NAVBAR ──
═══════════════════════════════════ */
.navbar{
  height:var(--nav);background:var(--white);
  border-top:2px solid var(--bd);      /* ← ナビ上枠 */
  display:flex;flex-shrink:0;
}
.ni{flex:1;display:flex;flex-direction:column;align-items:center;
    justify-content:center;gap:3px;cursor:pointer;padding:6px 2px;position:relative}
.ni.on .ni-ico,.ni.on .ni-lbl{color:var(--gn)}
.ni-ico{color:var(--t3);transition:color .12s}
.ni-lbl{font-size:10px;color:var(--t3);font-weight:600;transition:color .12s}
.ni-badge{position:absolute;top:5px;right:calc(50% - 14px);
          background:var(--red);color:#fff;font-size:9px;font-weight:700;
          min-width:16px;height:16px;border-radius:8px;
          display:flex;align-items:center;justify-content:center;padding:0 3px}

/* ═══════════════════════════════════
   ── BOTTOM SHEET (Add Contact) ──
═══════════════════════════════════ */
.bs-bg{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:300;
       display:none;align-items:flex-end;justify-content:center;backdrop-filter:blur(2px)}
.bs-bg.on{display:flex}
.bs{
  background:var(--white);width:100%;max-width:430px;
  border-radius:20px 20px 0 0;
  border:2px solid var(--bd);border-bottom:none;  /* ← シート枠 */
  overflow:hidden;max-height:80vh;
  display:flex;flex-direction:column;animation:slideUp .22s ease;
}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.bs-hdr{
  padding:13px 16px;
  border-bottom:2px solid var(--bd);
  display:flex;align-items:center;justify-content:space-between;
  background:#fafbfd;
}
.bs-title{font-size:16px;font-weight:700}
.bs-close{
  width:28px;height:28px;border-radius:8px;
  background:var(--bg);border:1.5px solid var(--bd);
  cursor:pointer;font-size:18px;color:var(--t3);
  display:flex;align-items:center;justify-content:center;line-height:1;
}
.bs-body{flex:1;overflow-y:auto}

/* QR section */
.qr-sec{padding:14px 16px;border-bottom:2px solid var(--bd)}
.qr-sec-title{font-size:11.5px;font-weight:700;color:var(--t2);
              text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
.qr-box{
  background:var(--bg);border:2px solid var(--bd);  /* ← QR枠 */
  border-radius:var(--r);padding:14px;
  display:flex;flex-direction:column;align-items:center;gap:10px;
}
.qr-wrap{
  width:140px;height:140px;background:var(--white);
  border:2px solid var(--bd);border-radius:12px;  /* ← QRコード枠 */
  display:flex;align-items:center;justify-content:center;padding:10px;
}
.qr-url-row{display:flex;gap:6px;width:100%}
.qr-url{
  flex:1;padding:9px 11px;border-radius:8px;
  background:var(--white);border:1.5px solid var(--bd);
  font-size:12px;color:var(--t2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.qr-copy{
  padding:9px 13px;border-radius:8px;
  border:2px solid var(--glt);background:var(--gbg);
  color:var(--gn);font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;font-family:inherit;
}
.qr-copy:active{background:var(--gn);color:#fff}

/* Contact list in sheet */
.ci{display:flex;align-items:center;gap:12px;padding:12px 16px;
    border-bottom:1.5px solid var(--bd);cursor:pointer;transition:background .1s}
.ci:last-child{border-bottom:none}
.ci:active{background:var(--gbg)}
.ci-av{width:44px;height:44px;border-radius:50%;border:2px solid var(--bd);
       display:flex;align-items:center;justify-content:center;
       font-size:14px;font-weight:700;flex-shrink:0;position:relative}
.ci-dot{position:absolute;bottom:0;right:0;width:11px;height:11px;
        border-radius:50%;border:2px solid var(--white)}
.ci-body{flex:1;min-width:0}
.ci-name{font-size:14px;font-weight:700}
.ci-role{font-size:12px;color:var(--t2);margin-top:2px}
.ci-add{
  width:32px;height:32px;border-radius:50%;
  background:var(--gbg);border:2px solid var(--glt);
  color:var(--gn);font-size:20px;font-weight:300;cursor:pointer;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;line-height:1;
  transition:all .14s;
}
.ci-add:active{background:var(--gn);color:#fff;transform:scale(.9)}

/* ═══════════════════════════════════
   TOAST
═══════════════════════════════════ */
.toasts{position:fixed;top:56px;left:50%;transform:translateX(-50%);
        width:calc(100% - 28px);max-width:400px;z-index:600;
        display:flex;flex-direction:column;gap:8px;pointer-events:none}
.toast{
  background:var(--white);
  border:2px solid var(--bd);          /* ← トースト枠 */
  border-radius:12px;padding:11px 13px;
  display:flex;gap:10px;align-items:center;
  box-shadow:0 6px 24px rgba(0,0,0,.12);
  pointer-events:all;animation:tin .2s ease;
}
@keyframes tin{from{transform:translateY(-12px) translateX(-50%);opacity:0}to{transform:translateY(0) translateX(-50%);opacity:1}}
@keyframes tout{to{transform:translateY(-12px) translateX(-50%);opacity:0}}
.toast.out{animation:tout .18s ease forwards}
.t-ico{width:28px;height:28px;border-radius:8px;border:1.5px solid transparent;
       display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}

/* VOICE BUTTON */
.voice-btn{width:36px;height:36px;border-radius:50%;border:2px solid var(--bd);background:var(--white);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--t2);transition:all .14s;flex-shrink:0}
.voice-btn.listening{background:var(--red);border-color:var(--red);color:#fff;animation:pulse-red 1s infinite}
@keyframes pulse-red{0%,100%{box-shadow:0 0 0 0 rgba(229,62,62,.4)}50%{box-shadow:0 0 0 8px rgba(229,62,62,0)}}
</style>
</head>

// 共通の日報送信処理
async function _doSubmitNippo(type, content){
  let translated='';
  try{ translated = await aiTx(content,'ja'); }catch{ translated = ''; }

  try{
    const res = await fetch('/worker/api/daily-reports',{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({type, content, translated}),
    });
    const json = await res.json();
    if(!json.ok) throw new Error(json.error || '送信に失敗しました');
    const now = new Date();
    NIPPOS.unshift({
      id: json.report?.id || 'n'+Date.now(),
      date: now.toLocaleDateString('ja-JP'),
      type, status: 'pending', content, translated, jp: translated,
    });

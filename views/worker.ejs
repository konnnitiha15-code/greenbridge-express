}

// TTS
function ttsToggle(){ttsOn?ttsStop():ttsStart();}
function ttsStart(){
  ttsOn=true;ttsCnt=0;
  document.getElementById('tts-ico').innerHTML='<rect x="2" y="2" width="3" height="10" rx="1" fill="white"/><rect x="8" y="2" width="3" height="10" rx="1" fill="white"/>';
  ttsTimer=setInterval(()=>{ttsCnt++;document.getElementById('tts-fill').style.width=Math.min(100,ttsCnt/90*100)+'%';const m=Math.floor(ttsCnt/60),s=ttsCnt%60;document.getElementById('tts-time').textContent=m+':'+(s<10?'0':'')+s;if(ttsCnt>=90)ttsStop();},1000);
  if(window.speechSynthesis){const u=new SpeechSynthesisUtterance(document.getElementById('dd-body').textContent);u.lang='ja-JP';u.rate=.9;u.onend=ttsStop;speechSynthesis.speak(u);}
}
function ttsStop(){
  ttsOn=false;clearInterval(ttsTimer);
  document.getElementById('tts-ico').innerHTML='<polygon points="3,2 12,7 3,12" fill="white"/>';
  if(window.speechSynthesis)speechSynthesis.cancel();
}


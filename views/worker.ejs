// ── メッセージ受信 API Polling（Supabase DB経由・全デバイス対応） ───────────────
// gb_msg localStorage ポーリングを廃止し、API polling に移行
const _ADMIN_UID  = _sd.adminUserId  || null;  // 管理者のauth user ID
const _MY_UID     = _sd.myUserId     || null;  // 自分のauth user ID
let   _msgLastTs  = new Date().toISOString();  // 最後に取得したメッセージのタイムスタンプ

async function _handleIncomingMessage(m){
  const body = m.body || '';
  let tl = m.translated || body;
  if(LANG !== 'ja'){ try{ tl = await aiTx(body, LANG); }catch{} }
  const time = new Date(m.created_at).toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'});
  const incomingM = { t:'other', txt: body, tl, time };

  // 管理者のcontactIdを特定（CONTACTS配列から）
  const adminContact = CONTACTS.find(c => c.id === _ADMIN_UID);
  const contactId    = adminContact?.id || (_ADMIN_UID || 'admin');

  const dm = getOrCreateDM(contactId);
  dm.msgs.push(incomingM);
  dm.unread = (dm.unread || 0) + 1;

  if(ACTIVE_CHAT && !ACTIVE_CHAT.isGroup && ACTIVE_CHAT.contactId === contactId){
    addActiveBubble(incomingM, true);
    dm.unread = 0;
  }

  const total = getChatListData().reduce((s,i)=>s+(i.unread||0),0);
  const badge = document.getElementById('chat-badge');
  if(badge){ badge.textContent=total; badge.style.display=total>0?'':'none'; }
  renderChatList();
  toast('担当者からメッセージ', tl.slice(0, 40));
}

// メッセージ取得（共通関数）
async function pollMessages(){
  if(!_MY_UID) return;
  try{
    // 全件取得（既読ステータスも反映するため）
    const res  = await fetch('/worker/api/messages');
    const json = await res.json();
    if(!json.ok) return;

    // 自分の送信メッセージの is_read を更新
    let needRender = false;
    for(const m of (json.messages||[])){
      if(m.sender_id === _MY_UID){
        // 自分が送ったメッセージ → DM_CHATS から見つけて is_read を更新
        for(const dm of DM_CHATS){
          const localMsg = (dm.msgs||[]).find(x => x._id === m.id);
          if(localMsg && localMsg.is_read !== m.is_read){
            localMsg.is_read = m.is_read;
            needRender = true;
          }
        }
      } else if(_ADMIN_UID && m.sender_id === _ADMIN_UID && m.receiver_id === _MY_UID){
        // 管理者からの新着 → タイムスタンプ比較して新規なら追加
        if(new Date(m.created_at) > new Date(_msgLastTs)){
          _msgLastTs = m.created_at;
          await _handleIncomingMessage(m);
        }
      }
    }
    // アクティブチャットの既読状態が変わったら再描画
    if(needRender && ACTIVE_CHAT && !ACTIVE_CHAT.isGroup){
      renderActiveMsgs();
    }
  }catch(e){ console.warn('[poll] error:', e); }
}

// Realtime購読を試み、失敗時はポーリングにフォールバック
(async () => {
  if (typeof GBRealtime === 'undefined' || !_MY_UID) {
    // Realtime未対応 → ポーリング
    setInterval(pollMessages, 8000);
    return;
  }
  try {
    // 新規メッセージ受信
    const sub = await GBRealtime.subscribeMessages(_MY_UID,
      async (newMsg) => {
        // 管理者からの自分宛て → 既存 _handleIncomingMessage に流す
        if (newMsg.sender_id === _ADMIN_UID && newMsg.receiver_id === _MY_UID) {
          await _handleIncomingMessage(newMsg);
          _msgLastTs = newMsg.created_at;
        }
      },
      // 自分の送信メッセージの既読状態更新
      (updatedMsg) => {
        if (updatedMsg.sender_id !== _MY_UID) return;
        for (const dm of DM_CHATS) {
          const localMsg = (dm.msgs || []).find(x => x._id === updatedMsg.id);
          if (localMsg && localMsg.is_read !== updatedMsg.is_read) {
            localMsg.is_read = updatedMsg.is_read;
            if (ACTIVE_CHAT && !ACTIVE_CHAT.isGroup) renderActiveMsgs();
          }
        }
      });
    if (!sub) setInterval(pollMessages, 8000);  // フォールバック
    else console.log('[Realtime] messages active, polling disabled');
  } catch (e) {
    console.warn('[Realtime] init failed, falling back to polling:', e);
    setInterval(pollMessages, 8000);
  }
})();

// グループメッセージポーリング（アクティブなグループ + 全グループ未読チェック）
async function pollGroupMessages(){
  if(!_MY_UID || !GROUPS.length) return;
  for(const g of GROUPS){
    try{
      const after = _wGroupMsgLastTs[g.id] || '';
      const url   = `/worker/api/groups/${g.id}/messages${after?'?after='+encodeURIComponent(after):''}`;
      const res   = await fetch(url);
      const json  = await res.json();
      if(!json.ok || !json.messages?.length) continue;
      for(const m of json.messages){
        _wGroupMsgLastTs[g.id] = m.created_at;
        if(m.sender_id === _MY_UID) continue;  // 自分のは追加しない
        if(!g.msgs) g.msgs = [];
        g.msgs.push(_wGMsgToLocal(m, _MY_UID));
        g.unread = (g.unread||0) + 1;
        // アクティブなグループなら画面に追加
        if(ACTIVE_CHAT?.isGroup && ACTIVE_CHAT.id === g.id){
          addActiveBubble(g.msgs.at(-1), true);
          g.unread = 0;
        }
      }
    }catch(e){ console.warn('[group poll] error:', e); }
  }
  renderChatList();
}
// Realtimeでグループメッセージ受信、フォールバックでポーリング
(async () => {
  // 起動直後はGROUPSが空なので、ロード後に購読開始
  const tryRealtime = async () => {
    if (typeof GBRealtime === 'undefined' || !_MY_UID || !GROUPS.length) return false;
    const groupIds = GROUPS.map(g => g.id);
    const sub = await GBRealtime.subscribeGroupMessages(_MY_UID, groupIds, async (newMsg) => {
      const g = GROUPS.find(x => x.id === newMsg.group_id);
      if (!g) return;
      _wGroupMsgLastTs[g.id] = newMsg.created_at;
      g.msgs = g.msgs || [];
      g.msgs.push(_wGMsgToLocal(newMsg, _MY_UID));
      if (ACTIVE_CHAT?.isGroup && ACTIVE_CHAT.id === g.id) {
        addActiveBubble(g.msgs.at(-1), true);
      } else {
        g.unread = (g.unread || 0) + 1;
      }
      renderChatList();
    });
    return !!sub;
  };

  if (!(await tryRealtime())) {
    // 初回失敗（GROUPS未ロード）→ ロード待ってリトライ
    setTimeout(async () => {
      if (!(await tryRealtime())) {
        setInterval(pollGroupMessages, 10000);
        console.log('[Realtime] group fallback to polling');
      } else {
        console.log('[Realtime] group_messages active');
      }
    }, 2000);
  } else {
    console.log('[Realtime] group_messages active');
  }
})();


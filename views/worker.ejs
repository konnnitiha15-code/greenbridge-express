            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="qa-grid">
      <div class="qa-item" onclick="go('s-chat')">
        <div class="qa-ico" style="background:#e8f4ff"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M3 5a2 2 0 012-2h12a2 2 0 012 2v9a2 2 0 01-2 2H13l-5 4v-4H5a2 2 0 01-2-2V5z" stroke="#2563eb" stroke-width="1.7" fill="none"/></svg></div>

  } else {
    topAv.style.cssText = `width:38px;height:38px;border-radius:50%;background:${item.avBg};color:${item.avTc};display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0`;
  }
  document.getElementById('chat-top-name').textContent = item.name;
  document.getElementById('chat-top-sub').textContent = item.isGroup
    ? `グループ · AI一斉翻訳オン`
    : (item.online ? '● オンライン' : '○ オフライン') + ' · AI翻訳オン · ' + (getContact(item.contactId)?.dept||'');

  const badge = document.getElementById('chat-top-badge');
  badge.innerHTML = item.isGroup
    ? '<span class="badge bg" style="font-size:10px">グループ</span>'
    : '<span class="badge bb" style="font-size:10px">個別</span>';

  // Placeholder
  const inp = document.getElementById('active-inp');
  if (inp) inp.placeholder = item.isGroup
    ? 'グループに送信 → 全メンバーに一斉翻訳'
    : '母国語で入力 → AIが日本語に翻訳して送信';

  // Background color
  const msgs = document.getElementById('active-msgs');
  msgs.style.background = item.isGroup ? '#e8ede4' : '#e9edf2';

  // Render messages

        <span class="qa-lbl" id="nl-shift-qa">シフト</span>
      </div>
      <div class="qa-item" onclick="go('s-nippo')">
        <div class="qa-ico" style="background:#fff7ed"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="2" width="16" height="18" rx="3" stroke="#ea580c" stroke-width="1.7" fill="none"/><path d="M7 8h8M7 12h6M7 16h4" stroke="#ea580c" stroke-width="1.4" stroke-linecap="round"/></svg></div>
        <span class="qa-lbl" id="h-nippo-l">日報</span>
      </div>
      <div class="qa-item" onclick="go('s-videos')">

// ── 言語変更専用バナー（既存のtoastとは別レイヤー、最上部に固定）
function showLangToast(flag,name,msg){
  // 既存の言語バナーを消す
  document.querySelectorAll('.lang-banner').forEach(e=>e.remove());
  const banner=document.createElement('div');
  banner.className='lang-banner';
  banner.style.cssText=`
    position:fixed;top:0;left:50%;transform:translateX(-50%);
    width:calc(100% - 0px);max-width:430px;z-index:1000;
    background:var(--gn);border-bottom:2px solid var(--gd);
    padding:10px 18px;display:flex;align-items:center;gap:10px;
    animation:langIn .22s ease;
  `;
  banner.innerHTML=`
    <style>@keyframes langIn{from{transform:translateX(-50%) translateY(-100%)}to{transform:translateX(-50%) translateY(0)}}</style>
    <span style="font-size:22px">${flag}</span>
    <div style="flex:1">
      <div style="font-size:13.5px;font-weight:700;color:#fff">${name}</div>
      <div style="font-size:12px;color:rgba(255,255,255,.8);margin-top:1px">${msg}</div>
    </div>
    <div style="width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.2);
                display:flex;align-items:center;justify-content:center;cursor:pointer;
                font-size:14px;color:#fff;flex-shrink:0" onclick="this.parentElement.remove()">×</div>
  `;
  document.body.appendChild(banner);
  setTimeout(()=>{
    banner.style.animation='langIn .2s ease reverse forwards';
    setTimeout(()=>banner.remove(),220);
  },2800);
}



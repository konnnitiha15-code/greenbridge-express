}

const SCRS=['s-home','s-chat','s-tpl','s-docs','s-videos','s-nippo','s-shift','s-sos','s-settings'];
const NMAP={'s-home':'n-home','s-chat':'n-chat','s-tpl':'n-tpl','s-docs':'n-docs','s-videos':null,'s-nippo':null,'s-shift':'n-shift','s-sos':null,'s-settings':'n-settings'};

function go(id){
  SCRS.forEach(s=>document.getElementById(s)?.classList.toggle('on',s===id));
  Object.entries(NMAP).forEach(([s,n])=>{if(n)document.getElementById(n)?.classList.toggle('on',s===id);});
  document.getElementById('ddover')?.classList.remove('on');
  document.getElementById('vdov')?.classList.remove('on');
  document.getElementById('npov')?.classList.remove('on');
  document.getElementById('npov-new')?.classList.remove('on');
  
  if(id==='s-home'){
    // ホームを開くたびに日報状況とシフトを最新化
    if(typeof loadAndRenderNippos==='function') loadAndRenderNippos();
    if(typeof loadAndRenderShift==='function') loadAndRenderShift();
  }
  if(id==='s-tpl'){
    document.getElementById('tpl-form-overlay')?.classList.remove('on');
    const tfr=document.getElementById('tf-result');if(tfr) tfr.className='result-box';
    renderTpls();  // 申請テンプレートを毎回描画
  }
  if(id==='s-chat'){
    // グループ一覧を更新してからリスト描画
    if(typeof loadWorkerGroups==='function'){
      loadWorkerGroups().then(()=>renderChatList());
    } else {
      renderChatList();
    }
    if(typeof pollMessages==='function') pollMessages();        // 個別メッセージ即時取得
    if(typeof pollGroupMessages==='function') pollGroupMessages(); // グループ即時取得
  }
  if(id==='s-videos')renderVList();
  if(id==='s-nippo'){
    renderNPList();
    if(typeof loadAndRenderNippos==='function') loadAndRenderNippos();  // DBから最新取得
  }
  if(id==='s-shift'){
    loadAndRenderShift();
    // シフトタブを開いている間は30秒ごとに自動更新
    if(window._shiftAutoTimer) clearInterval(window._shiftAutoTimer);
    window._shiftAutoTimer = setInterval(()=>{
      const screen = document.getElementById('s-shift');
      if(screen && screen.classList.contains('on')) loadAndRenderShift();
      else { clearInterval(window._shiftAutoTimer); window._shiftAutoTimer = null; }
    }, 30000);
  }
  if(id==='s-docs')renderWDocs();
  if(id==='s-settings'){
    if(typeof renderNotifSwitch==='function') renderNotifSwitch();
  }
}

// ── TOAST ─────────────────────────────────────────────────────────────────────
function toast(title,body,type='g'){
  const c=document.getElementById('toasts'),t=document.createElement('div');t.className='tw';
  const cols={g:'var(--gn)',r:'var(--red)',a:'var(--amb)',b:'var(--blu)'};
  const bgs={g:'var(--gbg)',r:'var(--rbg)',a:'var(--abg)',b:'var(--bbg)'};
  const icos={g:'✓',r:'!',a:'⚠',b:'ℹ'};
  t.innerHTML=`<div style="width:26px;height:26px;border-radius:7px;background:${bgs[type]};color:${cols[type]};display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0">${icos[type]||'●'}</div><div style="flex:1"><div style="font-size:13px;font-weight:700;color:var(--tx)">${title}</div><div style="font-size:12px;color:var(--t2);margin-top:1px">${body||''}</div></div>`;
  c.appendChild(t);
  setTimeout(()=>{t.classList.add('out');setTimeout(()=>t.remove(),160);},3800);
}


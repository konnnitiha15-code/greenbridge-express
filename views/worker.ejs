function renderActiveMsgs() {
  const area = document.getElementById('active-msgs');
  area.innerHTML = '';
  let msgs = [];
  if (ACTIVE_CHAT?.isGroup) {
    msgs = GROUPS.find(g=>g.id===ACTIVE_CHAT.id)?.msgs || [];
  } else {
    // DM
    const dm = DM_CHATS.find(d=>d.id===ACTIVE_CHAT?.id);
    msgs = dm?.msgs || [];
  }
  msgs.forEach(m => addActiveBubble(m, false));
  area.scrollTop = area.scrollHeight;
}

function addActiveBubble(m, scroll=true) {
  const area = document.getElementById('active-msgs');
  if (!area) return;
  if (m.t === 'sys') {
    const d = document.createElement('div');
    d.className = 'sys-msg'; d.textContent = m.txt;
    area.appendChild(d);
    if(scroll) area.scrollTop = area.scrollHeight;
    return;
  }
  const isMe = m.t === 'me';
  const row = document.createElement('div');
  row.className = 'crow' + (isMe ? ' me' : '');

  let mainHtml = '';
  // Group: show sender name above bubble
  if (!isMe && ACTIVE_CHAT?.isGroup && m.sender) {
    mainHtml += `<span style="font-size:11px;font-weight:700;color:var(--gn);display:block;margin-bottom:2px">${m.sender}</span>`;
  }
  mainHtml += m.txt;
  // Show translation
  if (m.tl && !isMe) {
    mainHtml += `<div style="margin-top:4px;font-size:12px;color:#065f46;background:#ecfdf5;border-radius:6px;padding:4px 8px"><span style="font-size:10.5px;font-weight:700;display:block;margin-bottom:1px">【AI翻訳】</span>${m.tl}</div>`;
  }
  // 自分の送信メッセージに既読インジケータ（is_read プロパティから判定）
  const readMark = isMe ? `<div style="font-size:10px;color:${m.is_read?'#0ea5e9':'#94a3b8'};margin-top:2px;font-weight:600">${m.is_read?'既読 ✓✓':'送信済 ✓'}</div>` : '';

  if (m.tl && isMe) {
    const colBub = document.createElement('div');
    colBub.className = 'mcol';
    colBub.style.alignItems = 'flex-end';
    const bub = document.createElement('div');
    bub.className = 'cbub c-me';
    bub.textContent = m.txt;
    const tlBub = document.createElement('div');
    tlBub.className = 'cbub c-ai';
    tlBub.style.marginTop = '2px';
    tlBub.innerHTML = '<span style="font-size:10.5px;font-weight:700;color:#065f46;display:block;margin-bottom:1px">【翻訳済み → 日本語】</span>' + m.tl;
    const mtime = document.createElement('div');
    mtime.className = 'mtime';
    mtime.innerHTML = (m.time||'') + readMark;
    colBub.appendChild(bub); colBub.appendChild(tlBub); colBub.appendChild(mtime);
    row.appendChild(colBub);
    area.appendChild(row);
    if(scroll) area.scrollTop = area.scrollHeight;
    return;
  }

  const bub = document.createElement('div');
  bub.className = 'bub ' + (isMe ? 'me' : 'other');
  bub.innerHTML = mainHtml;

  if (!isMe) {
    const av = document.createElement('div');
    av.className = 'cmav';
    if (ACTIVE_CHAT?.isGroup && m.sender) {
      av.style.cssText = 'background:#e2e8f0;color:#475569';
      av.textContent = m.sender[0];
    } else {
      av.style.cssText = 'background:var(--gbg);color:var(--gn)';
      av.textContent = '田';
    }
    row.appendChild(av);
  }

  const col = document.createElement('div');
  col.className = 'mcol';
  if(isMe) col.style.alignItems='flex-end';
  col.appendChild(bub);
  const mtime = document.createElement('div');
  mtime.className='mtime';
  mtime.innerHTML = (m.time||'') + readMark;
  col.appendChild(mtime);
  row.appendChild(col);
  area.appendChild(row);
  if(scroll) area.scrollTop = area.scrollHeight;
}

function insertActive(txt) {

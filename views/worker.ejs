// ── 音声入力（Web Speech API）
let voiceRec=null,voiceOn=false;
function toggleVoice(){
  const btn=document.getElementById('voice-btn');
  const inp=document.getElementById('active-inp');
  if(!('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)){
    toast('音声入力','このブラウザでは音声入力に対応していません','r');return;
  }
  if(voiceOn){
    voiceRec?.stop();voiceOn=false;
    if(btn)btn.classList.remove('listening');
    return;
  }
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  voiceRec=new SR();
  voiceRec.lang=LANG==='ja'?'ja-JP':LANG==='zh'?'zh-CN':'vi-VN';
  voiceRec.interimResults=true;voiceRec.continuous=false;
  voiceRec.onstart=()=>{voiceOn=true;if(btn)btn.classList.add('listening');toast('音声入力','話してください...','b');};
  voiceRec.onresult=e=>{
    let txt='';for(let i=e.resultIndex;i<e.results.length;i++)txt+=e.results[i][0].transcript;
    if(inp)inp.value=txt;autoSz(inp);
  };
  voiceRec.onend=()=>{voiceOn=false;if(btn)btn.classList.remove('listening');};
  voiceRec.onerror=()=>{voiceOn=false;if(btn)btn.classList.remove('listening');toast('エラー','音声入力に失敗しました','r');};
  voiceRec.start();
}


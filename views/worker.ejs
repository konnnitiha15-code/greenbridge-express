// ── サーバーデータをUIに反映 ─────────────────────────────────────────────────
(function applyServerData(){
  if(!_sw.name) return;

  // 在籍年数を計算
  function calcYear(dateStr){
    if(!dateStr) return '';
    const y = new Date().getFullYear() - new Date(dateStr).getFullYear();
    return y > 0 ? y+'年目' : '1年目';
  }
  const year = calcYear(_sw.entryDate);
  const sub  = [_sw.name, _sw.jobTitle, year].filter(Boolean).join(' · ');
  const psub = [_sw.jobTitle, year, _sw.department].filter(Boolean).join(' · ');
  const init = (_sw.name.trim().split(/\s+/).map(p=>p[0]).slice(0,2).join('')).toUpperCase() || '?';

  // Hero
  const heroSub = document.getElementById('w-hero-sub');
  if(heroSub) heroSub.textContent = sub;
  const hgreet = document.getElementById('h-greet');
  if(hgreet) hgreet.textContent = (LS[savedLang]||LS.vi).greet + ', ' + (_sw.name.split(' ')[0] || '') + ' さん';

  // Settings profile header
  const pav   = document.getElementById('w-pav');   if(pav)  pav.textContent  = init;
  const pname = document.getElementById('w-pname'); if(pname) pname.textContent = _sw.name;
  const pwsub = document.getElementById('w-psub');  if(pwsub) pwsub.textContent = psub;

  // Settings account rows
  const stn = document.getElementById('w-st-name');    if(stn) stn.textContent = _sw.name;
  const ste2= document.getElementById('w-st-email');   if(ste2) ste2.textContent = _sd.email || '—';
  const stc = document.getElementById('w-st-company'); if(stc) stc.textContent = _sd.companyName || '';
  const stm = document.getElementById('w-st-manager'); if(stm) stm.textContent = _sw.supervisor || '';

  // 担当者名をハードコードから動的に置換
  const supervisorName = _sw.supervisor || CONTACTS[0]?.name || '担当者';
  const supervisorInit = supervisorName.trim().slice(0,1) || '担';
  const tplName = document.getElementById('tpl-recipient-name'); if(tplName) tplName.textContent = supervisorName + '（担当責任者）';
  const tplInit = document.getElementById('tpl-recipient-init'); if(tplInit) tplInit.textContent = supervisorInit;
  const sosName = document.getElementById('sos-contact-name');  if(sosName) sosName.textContent = supervisorName + '（担当者）';
  // 各言語のchatNameも実担当者名で上書き
  Object.keys(LS).forEach(lang => { if(LS[lang]) LS[lang].chatName = supervisorName; });
  const ste = document.getElementById('st-tenure-val');
  if(ste && year) ste.textContent = year + (_sw.entryDate ? '（'+_sw.entryDate.slice(0,7).replace('-','年')+'月〜）' : '');
})();

updateProg();loadAndRenderShift();
// 起動時にグループ一覧を取得（バックグラウンド）
if(typeof loadWorkerGroups==='function') loadWorkerGroups().then(()=>{ if(typeof renderChatList==='function') renderChatList(); });
// 起動時に日報も取得（ホーム画面のバッジ表示用）
if(typeof loadAndRenderNippos==='function') loadAndRenderNippos();

// attendance.js 読み込み後に初期化（script タグの後で呼ぶ）

// ── ADD CONTACT ──────────────────────────────────────────────────────────────
function openAddContactModal() {
  const addedIds = DM_CHATS.map(dm=>dm.contactId);
  const available = CONTACTS.filter(ct => !addedIds.includes(ct.id));
  const el = document.getElementById('contact-list-items');
  if(el) {
    if(available.length===0){
      el.innerHTML='<div style="padding:24px;text-align:center;color:#9ca3af;font-size:13px">追加できる関係者がいません</div>';
    } else {
      el.innerHTML = available.map(ct=>`
        <div class="contact-item" onclick="addContactDM('${ct.id}')">
          <div class="ci-av" style="background:${ct.avBg};color:${ct.avTc}">${ct.init}<div class="ci-dot" style="background:${ct.online?'var(--gn)':'var(--t3)'}"></div></div>
          <div class="ci-body"><div class="ci-name">${ct.name}</div><div class="ci-role">${ct.role} · ${ct.dept}</div></div>
          <button class="ci-add">＋</button>
        </div>`).join('');
    }
  }
  document.getElementById('add-contact-bg').classList.add('on');
}

function closeAddContactSheet(e){
  if(e&&e.target!==document.getElementById('add-contact-bg'))return;
  document.getElementById('add-contact-bg').classList.remove('on');
}

function copyInviteUrl(){
  const url=document.getElementById('invite-url')?.textContent||'https://gb.app/chat/ng-12345';
  if(navigator.clipboard){navigator.clipboard.writeText(url).then(()=>toast('コピー完了','招待URLをコピーしました','g'));}
  else{toast('コピー完了','招待URLをコピーしました','g');}
}

function addContactDM(contactId) {
  document.getElementById('add-contact-bg').classList.remove('on');
  const ct = getContact(contactId);
  if(!ct) return;
  getOrCreateDM(contactId);
  renderChatList();
  // Open the new DM immediately
  const dm = getDM(contactId);
  if(dm) {
    const item = getChatListData().find(x=>x.id===dm.id);
    if(item) openChatItem(item);
  }
  toast('追加完了', ct.name + ' とのチャットを開始しました');
}

// ── INIT ──────────────────────────────────────────────────────────────────────
</script>
<script src="/js/worker/attendance.js"></script>
<script src="/js/services/push-client.js"></script>
<script>
Attendance.init();

// ── PWA + Web Push 初期化 ──────────────────────────────────────
// SW を登録し、既存購読を最新サーバー状態に同期。
// 通知許可は ユーザーアクション（設定タブの「通知を有効化」ボタン）からのみ要求する。
if (window.GBPush) {
  window.addEventListener('load', () => { GBPush.init().catch(()=>{}) });
}

// 設定タブで使う通知トグルのヘルパ（HTML側で呼び出し）
window.gbToggleNotifications = async function () {
  if (!window.GBPush || !GBPush.isSupported()) {
    alert('このブラウザはプッシュ通知に対応していません');
    return;
  }
  try {
    const st = await GBPush.getStatus();
    if (st.subscribed) {
      await GBPush.disable();
      if (typeof toast === 'function') toast('通知を無効化', 'プッシュ通知を停止しました', 'g');
    } else {
      await GBPush.enable();
      if (typeof toast === 'function') toast('通知を有効化', 'プッシュ通知が届くようになりました', 'g');
    }
    if (typeof renderNotifSwitch === 'function') renderNotifSwitch();
  } catch (e) {
    alert(e.message || '通知設定の変更に失敗しました');
  }
};

window.gbTestNotification = async function () {
  try {
    const r = await GBPush.test();
    if (!r.ok) alert('テスト送信失敗: ' + (r.error || 'unknown'));
  } catch (e) { alert(e.message); }
};

// 設定タブを開いた時に現状を反映するレンダラ
window.renderNotifSwitch = async function () {
  const btn = document.getElementById('btn-toggle-notif');
  const lbl = document.getElementById('notif-status-label');
  if (!btn) return;
  if (!window.GBPush || !GBPush.isSupported()) {
    btn.disabled = true;
    btn.textContent = '非対応';
    if (lbl) lbl.textContent = 'このブラウザは非対応';
    return;
  }
  const st = await GBPush.getStatus();
  if (st.permission === 'denied') {
    btn.disabled = true;
    btn.textContent = 'ブロック中';
    if (lbl) lbl.textContent = 'ブラウザ設定で通知が拒否されています';
    return;
  }
  btn.disabled = false;
  btn.textContent = st.subscribed ? '無効化する' : '有効化する';
  if (lbl) lbl.textContent = st.subscribed ? '✅ 受信中' : '受信していません';
};
</script>

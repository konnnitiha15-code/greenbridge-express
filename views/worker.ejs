const DM_CHATS = [];

// ── GROUPS: DB から取得 ──────────────────────────────────────
let GROUPS = [];
let _wGroupMsgLastTs = {}; // group.id → 最終取得タイムスタンプ

async function loadWorkerGroups(){
  try{
    const res  = await fetch('/worker/api/groups');
    const json = await res.json();
    if(!json.ok) return;
    GROUPS = (json.groups || []).map(g => ({
      id:      g.id,
      name:    g.name,
      icon:    g.icon || '👥',
      bg:      g.bg_color || '#e0e7ff',
      desc:    g.description || '',
      msgs:    [],
      unread:  0,
      prev:    '',
      time:    '',
    }));
  }catch(e){ console.warn('[group] load error:', e); }
}

function _wGMsgToLocal(m, myUid){
  const time = new Date(m.created_at).toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'});
  const isMe = m.sender_id === myUid;
  return { t: isMe?'me':'other', txt: m.body, tl: m.translated||'', time, _id: m.id, sender_id: m.sender_id };
}

async function loadGroupMessages(g){
  try{
    const res = await fetch(`/worker/api/groups/${g.id}/messages`);
    const json = await res.json();
    if(!json.ok) return;
    g.msgs = (json.messages||[]).map(m => _wGMsgToLocal(m, _MY_UID));
    if(json.messages?.length) _wGroupMsgLastTs[g.id] = json.messages.at(-1).created_at;
  }catch(e){ console.warn('[group msg] load error:', e); }
}

// Helpers
function getContact(id){ return CONTACTS.find(x=>x.id===id); }
function getDM(contactId){ return DM_CHATS.find(x=>x.contactId===contactId); }
function getOrCreateDM(contactId){
  let dm = getDM(contactId);
  if(!dm){
    dm = {id:'dm_'+contactId, contactId, msgs:[{t:'sys',txt:'チャット開始 — AI翻訳が有効です'}]};
    DM_CHATS.push(dm);
  }
  return dm;
}



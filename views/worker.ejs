// ── UNIFIED CHAT ─────────────────────────────────────────────────────────────
// DIRECT = 担当者との個別チャット, GROUPS = グループチャット
// DIRECT_MSGS migrated to DM_CHATS

// Current chat context: {type:'direct'} or {type:'group', group: GROUPS[i]}
let ACTIVE_CHAT = null;

// Build list data: direct first, then groups
function getChatListData() {
  // Individual DMs from DM_CHATS
  const dms = DM_CHATS.map(dm => {
    const ct = getContact(dm.contactId) || {};
    const lastMsg = dm.msgs.filter(m=>m.t!=='sys').slice(-1)[0];
    return {
      id: dm.id,
      type: 'dm',
      dmId: dm.id,
      contactId: dm.contactId,
      av: ct.init || '?',
      avBg: ct.avBg || '#e2e8f0',
      avTc: ct.avTc || '#374151',
      name: ct.name || dm.contactId,
      nameShort: (ct.name||'').split(' ')[0] + '\n' + (ct.role||''),
      sub: (ct.online?'● ':'○ ') + (ct.role||''),
      unread: dm.unread||0,
      prev: lastMsg ? (lastMsg.tl||lastMsg.txt||'').slice(0,18)+'…' : 'メッセージなし',
      time: lastMsg?.time||'',
      isGroup: false,
      online: ct.online||false,
    };
  });
  const groups = GROUPS.map(g => ({
    id: g.id,
    type: 'group',
    av: g.ico,
    avBg: g.bg,
    avTc: '#374151',
    name: g.name,
    nameShort: g.name.split('—')[0].trim().slice(0,6),
    sub: 'グループ',
    unread: g.unread || 0,
    prev: g.prev,
    time: g.time||'',
    isGroup: true,
    group: g,
  }));
  return [...dms, ...groups];
}

function renderChatList() {
  const el = document.getElementById('cl-items');
  el.innerHTML = '';
  const items = getChatListData();

  // Section: 個別チャット（ヘッダー + 追加ボタン）
  const dmHdrRow = document.createElement('div');
  dmHdrRow.style.cssText = 'display:flex;align-items:center;justify-content:space-between;padding:0 2px';
  dmHdrRow.innerHTML = '<div class="cl-section-lbl" style="padding:8px 4px 3px">個別</div>'
    + '<button onclick="openAddContactModal()" style="background:none;border:none;cursor:pointer;color:var(--gn);font-size:18px;padding:4px 2px;line-height:1" title="関係者を追加">＋</button>';
  el.appendChild(dmHdrRow);

  items.filter(i => !i.isGroup).forEach(item => renderCLItem(el, item));

  // Section: グループ
  const gcLbl = document.createElement('div');
  gcLbl.className = 'cl-section';
  el.appendChild(gcLbl);

  items.filter(i => i.isGroup).forEach(item => renderCLItem(el, item));

  // Update total badge
  const total = items.reduce((s,i) => s + (i.unread||0), 0);
  const b = document.getElementById('chat-badge');
  if (b) { b.textContent = total; b.style.display = total > 0 ? '' : 'none'; }
}

function renderCLItem(el, item) {
  const d = document.createElement('div');
  const isOn = ACTIVE_CHAT?.id === item.id;
  d.className = 'cl-item' + (isOn ? ' on' : '');
  d.id = 'cli-' + item.id;
  d.onclick = () => openChatItem(item);
  const avStyle = item.isGroup
    ? `width:40px;height:40px;border-radius:11px;background:${item.avBg};border:2px solid var(--bd);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0`
    : `width:40px;height:40px;border-radius:50%;background:${item.avBg};border:2px solid var(--bd);color:${item.avTc};display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0`;
  const br='<br>';d.innerHTML=`<div style="${avStyle}">${item.av}</div><div class="cl-item-name">${item.nameShort.replace('\\n',br)}</div>${item.unread?`<div class="cl-item-unread">${item.unread}</div>`:''}`;
  el.appendChild(d);
}

async function openChatItem(item) {
  ACTIVE_CHAT = item;
  // Clear unread
  if (item.isGroup) {
    const g = GROUPS.find(x=>x.id===item.id);
    if(g) {
      g.unread=0;
      await loadGroupMessages(g);
      item.group = g;
    }
  } else {
    const dm = DM_CHATS.find(d=>d.id===item.id); if(dm) dm.unread=0;
    // 個別チャット: この相手からの自分宛てメッセージを既読にマーク
    if(item.contactId){
      fetch('/worker/api/messages/read',{
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({sender_id: item.contactId})
      }).catch(()=>{});
    }
  }
  // Update list
  renderChatList();
  // Show active pane
  document.getElementById('chat-welcome-pane').style.display = 'none';
  const ap = document.getElementById('chat-active-pane');
  ap.style.display = 'flex';

  // Header

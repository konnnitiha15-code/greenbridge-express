// 管理者が入力するシフト種別の表記ゆれを正規化
function normalizeShiftType(raw){
  // 元の文字列そのまま（大文字小文字を保持）で照合
  const s = (raw||'').trim();
  // 日勤: 'niku' 'day' '日' '日勤' 'daytime' '普通'
  if(['niku','日勤','day','daytime','普通','日'].includes(s))       return 'niku';
  // 早番: 'hayaban' 'morning' '早' '早番'
  if(['hayaban','早番','morning','early','早'].includes(s))         return 'hayaban';
  // 遅番: 'osoi' 'late' '遅' '遅番'
  if(['osoi','遅番','evening','late','遅'].includes(s))             return 'osoi';
  // 休日: 'rest' 'off' '休' '休み'
  if(['rest','休み','休','off','holiday'].includes(s))              return 'rest';
  // 有休: '有' '有休' '有給'
  if(['有','有休','有給','yukyuu','paid'].includes(s))              return 'yukyuu';
  // 欠勤: '欠' '欠勤'
  if(['欠','欠勤','absent'].includes(s))                           return 'absent';
  return 'tbd';
}

// APIからシフトを取得して workerShifts に追記（リセットはしない）
async function loadWorkerShifts(year, month){
  try {
    const res  = await fetch(`/worker/api/shifts?year=${year}&month=${month}`);
    // セッション切れなどでHTMLが返った時のガード
    const ct = res.headers.get('content-type') || '';
    if (!ct.includes('application/json')) {
      console.warn('[shift] non-JSON response, possibly session expired');
      return;
    }
    const json = await res.json();
    if(!json.ok) return;
    (json.shifts || []).forEach(s => { workerShifts[s.date] = s.shift_type; });
  } catch(e) {
    console.error('[shift] load error:', e);
  }
}

// シフト画面を開いたとき・週移動のたびに呼ぶ
async function loadAndRenderShift(){
  const data  = buildShiftData(shiftWeekOffset);
  const year  = data[0].year;
  const month = data[0].month;
  const lastMonth = data[6].month;

  // リセットをここで1回だけ行う（複数月またぎでも上書きしない）
  workerShifts = {};
  await loadWorkerShifts(year, month);
  if(lastMonth !== month) await loadWorkerShifts(data[6].year, lastMonth);
  renderShift();
  updateHomeTodayShift();   // ホームの「今日のシフト」も最新化
}

// ホーム画面の「今日のシフト」ラベルを更新
function updateHomeTodayShift(){
  const el = document.getElementById('h-today-shift-val');
  if(!el) return;
  const now = new Date();
  const todayKey = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
  const raw = workerShifts[todayKey];
  if(!raw){ el.textContent = '未定'; return; }
  const type = normalizeShiftType(raw);
  const labelMap = {niku:'日勤',hayaban:'早番',osoi:'遅番',rest:'休み',yukyuu:'有休',absent:'欠勤',tbd:'未定'};
  el.textContent = labelMap[type] || raw;
}

function renderShift(){
  const el=document.getElementById('shift-week');if(!el)return;el.innerHTML='';
  // ワーカー情報表示（誤認防止）— window.SERVER_DATA経由でTDZ回避
  const winfo = document.getElementById('sh-worker-info');
  if(winfo){
    const sd = window.SERVER_DATA || {};
    const sw = sd.worker || {};
    winfo.textContent = `${sw.name || ''}（${sd.email || ''}）のシフト`;
  }
  const L=LS[LANG]||LS.vi;
  const labelMap={
    niku:   L.shiftNiku   ||'日勤',
    hayaban:L.shiftHayaban||'早番',
    osoi:   L.shiftOsoi   ||'遅番',
    rest:   L.shiftRest   ||'休み',
    yukyuu: '有休',
    absent: '欠勤',
    tbd:    '未定',
  };

  // 7列グリッドで全曜日を表示
  el.style.cssText='display:grid;grid-template-columns:repeat(7,1fr);gap:5px;padding:10px 12px;';

  const data = buildShiftData(shiftWeekOffset);

  // 期間ラベル
  const first = data[0], last = data[6];
  const periodEl = document.getElementById('sh-period');
  if(periodEl){
    const sameMonth = first.month === last.month;
    periodEl.textContent = sameMonth
      ? `${first.year}年${first.month}月${first.date}〜${last.date}日`
      : `${first.year}年${first.month}/${first.date}〜${last.month}/${last.date}`;
  }

  data.forEach(d=>{
    // DBのシフトデータで上書き（なければ未定）
    const dateKey = `${d.year}-${String(d.month).padStart(2,'0')}-${String(d.date).padStart(2,'0')}`;
    const dbType  = workerShifts[dateKey];
    const type    = dbType ? normalizeShiftType(dbType) : 'tbd';
    const lbl     = type === 'tbd' ? '未定' : (labelMap[type] || dbType);
    const c       = SHIFT_COLORS[type] || SHIFT_COLORS.tbd;

    const div=document.createElement('div');
    div.style.cssText=`
      background:${d.today?'var(--gbg)':'var(--white)'};
      border:${d.today?'2px solid var(--gn)':'1.5px solid var(--bd)'};
      border-radius:10px;padding:8px 3px;text-align:center;
    `;
    div.innerHTML=`
      <div style="font-size:10px;color:${d.dw==='日'?'var(--red)':d.dw==='土'?'var(--blu)':'var(--t3)'};margin-bottom:2px">${d.dw}</div>
      <div style="font-size:13px;font-weight:700;color:${d.today?'var(--gn)':'var(--tx)'};margin-bottom:5px">${d.date}</div>
      <div style="font-size:10px;font-weight:700;padding:3px 2px;border-radius:5px;background:${c.bg};color:${c.color}">${lbl}</div>
    `;
    el.appendChild(div);
  });
}


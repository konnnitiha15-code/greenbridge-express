        <div class="qa-ico" style="background:#fff0f0"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="9" stroke="#e53e3e" stroke-width="1.7" fill="none"/><path d="M11 7v6M11 16v.5" stroke="#e53e3e" stroke-width="2.2" stroke-linecap="round"/></svg></div>
        <span class="qa-lbl" id="h-sos-l">SOS</span>
      </div>

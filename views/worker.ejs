let NIPPOS = [];

async function loadAndRenderNippos(){
  try{
    const res  = await fetch('/worker/api/daily-reports');
    const json = await res.json();
    if(!json.ok) return;
    NIPPOS = (json.reports || []).map(r => ({
      id:         r.id,
      type:       r.type || 'daily',
      content:    r.content || '',
      translated: r.translated || '',
      jp:         r.translated || r.content || '',
      date:       (r.report_date || '').replace(/-/g,'/') || (r.created_at||'').slice(0,10),
      status:     r.status || 'pending',
    }));
    renderNPList(typeof npFilter !== 'undefined' ? npFilter : 'all');
    updateHomeNippoStatus();  // ホームのステータスバッジも更新
  }catch(e){
    console.warn('[nippo] load error:', e);
  }
}

// SHIFT_DATA を現在日付から動的生成
// 週オフセット（0=今週、-1=先週、+1=来週）
let shiftWeekOffset = 0;
// DBから取得したシフト { '2026-05-19': 'niku', ... }
let workerShifts = {};

function buildShiftData(offset){
  const now=new Date();
  const dw_ja=['日','月','火','水','木','金','土'];
  // 今週月曜 + offset週
  const monday=new Date(now);
  monday.setDate(now.getDate()-((now.getDay()+6)%7)+(offset||0)*7);
  return Array.from({length:7},(_,i)=>{
    const d=new Date(monday);d.setDate(monday.getDate()+i);
    return {
      dw:   dw_ja[d.getDay()],
      date: d.getDate(),
      month:d.getMonth()+1,
      year: d.getFullYear(),
      type: 'tbd',    // 未定（DBからシフトが届いた場合に上書き）
      label:'未定',
      today:d.toDateString()===now.toDateString()
    };
  });
}

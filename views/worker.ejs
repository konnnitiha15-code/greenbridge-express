      <div class="qa-item" onclick="go('s-settings')">
        <div class="qa-ico" style="background:#f6f7fa"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="3" stroke="#64748b" stroke-width="1.7" fill="none"/><path d="M11 2.5v3M11 16.5v3M2.5 11h3M16.5 11h3M5.6 5.6l2 2M14.4 14.4l2 2M5.6 16.4l2-2M14.4 7.6l2-2" stroke="#64748b" stroke-width="1.6" stroke-linecap="round"/></svg></div>
        <span class="qa-lbl" id="nl-settings-qa">設定</span>

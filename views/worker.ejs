        <span class="qa-lbl" id="nl-tpl-qa">申請</span>
      </div>
      <div class="qa-item" onclick="go('s-docs')">
        <div class="qa-ico" style="background:#fefce8"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="4" y="2" width="14" height="18" rx="3" stroke="#d97706" stroke-width="1.7" fill="none"/><path d="M7 8h8M7 12h8M7 16h5" stroke="#d97706" stroke-width="1.4" stroke-linecap="round"/></svg></div>
        <span class="qa-lbl" id="h-doc-l">書類</span>

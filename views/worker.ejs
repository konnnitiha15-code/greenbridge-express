// ── AI TRANSLATE（スタブ：翻訳機能は準備中）──
async function aiTx(text, lang) {
  if(!text||!text.trim()) throw new Error('テキストが空です');
  return text.trim();
}

// ── LANGUAGE ──────────────────────────────────────────────────────────────────
function applyL(code) {

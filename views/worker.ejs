<script>
// ── サーバーデータ（EJS注入）────────────────────────────────────────────────
window.SERVER_DATA = <%- JSON.stringify(serverData) %>;


// ── DATA ─────────────────────────────────────────────────────────────────────
const DOC_CONTENT={
  contract:`第1条（雇用）\n甲（会社）は乙（実習生）を技能実習生として雇用する。実習期間は1年間。\n\n第2条（労働時間）\n1日8時間、週40時間とする。\n\n第3条（給与）\n月額180,000円。毎月25日払い。\n\n第4条（保険）\n社会保険・雇用保険に加入する。\n\n第5条（有給休暇）\n法定通り付与する。初年度10日。`,
  rules:`第1条（出退勤）\n所定時間は8:00〜17:00とする。\n\n第2条（服装）\n作業着・安全靴を着用すること。\n\n第3条（禁止事項）\n職場での飲酒・喫煙は禁止。\n\n第4条（欠勤）\n欠勤の場合は前日までに申請すること。\n\n第5条（ハラスメント防止）\nあらゆるハラスメントを禁止する。違反者は厳正に処分する。`,
  safety:`第1章　安全の基本\n\n安全第一の原則：すべての作業において安全を最優先とすること。\n\nヒヤリ・ハット：危険を感じた場合は必ず担当者に報告すること。\n\n第2章　作業別安全基準\n機械操作時は保護具（手袋・安全靴・ゴーグル）を必ず着用する。\n\n第3章　緊急時対応\n火災発見時は「発見→通報→消火→避難」の順で対応。`
};

// ══════════════════════════════════════════════════════
// スマホアプリ書類タブ
// ══════════════════════════════════════════════════════

// 管理者側から届いた書類（Supabase → SERVER_DATA.docs、なければサンプル）
// 書類は Supabase から取得したもののみ表示（サンプルデータなし）
const W_DOCS = window.SERVER_DATA?.docs || [];

let wDocFilter = 'all';

function filterWDocs(cat, btn){
  wDocFilter = cat;
  document.querySelectorAll('#s-docs .chip').forEach(b=>b.classList.remove('on'));
  if(btn) btn.classList.add('on');
  renderWDocs();
}

function renderWDocs(){
  const el = document.getElementById('wdoc-list');
  if(!el) return;
  el.innerHTML = '';
  const L = LS[LANG]||LS.vi;
  const now = new Date();

  const visible = W_DOCS.filter(doc => {
    if(wDocFilter === 'all') return true;
    return doc.category === wDocFilter;
  });

  // 進捗更新
  const total = W_DOCS.length;
  const done  = confirmedDocs.size;
  const pct   = total ? Math.round(done/total*100) : 0;
  const pf = document.getElementById('prog-fill');
  if(pf) pf.style.width = pct + '%';
  const pt = document.getElementById('prog-txt');
  if(pt) pt.textContent = done + '/' + total;
  const ps = document.getElementById('prog-sub');
  if(ps) ps.textContent = L.progRemain || (total-done) + '件を確認してください';

  // 未確認バッジをナビに反映
  const unconf = total - done;
  const db = document.getElementById('docs-badge');
  if(db){ db.textContent = unconf; db.style.display = unconf > 0 ? '' : 'none'; }

  if(!visible.length){
    el.innerHTML = '<div style="padding:24px;text-align:center;color:#9ca3af;font-size:13px">書類がありません</div>';
    return;
  }

  visible.forEach(doc => {
    const isDone = confirmedDocs.has(doc.id);
    const lflags = {vi:'🇻🇳',id:'🇮🇩',tl:'🇵🇭',my:'🇲🇲',zh:'🇨🇳',km:'🇰🇭'};
    const langStr = doc.langs.map(l=>lflags[l]||l).join(' ');

    // 期限警告
    let expWarn = '';
    if(doc.expireDate){
      const diff = (new Date(doc.expireDate)-now)/(1000*60*60*24);
      if(diff < 0)
        expWarn = '<div style="margin-top:4px;font-size:11px;color:var(--red);font-weight:600">⚠ 期限切れ: '+doc.expireDate+'</div>';
      else if(diff <= 7)
        expWarn = '<div style="margin-top:4px;font-size:11px;color:var(--amb);font-weight:600">⏰ 期限まで'+Math.ceil(diff)+'日</div>';
    }

    const card = document.createElement('div');
    card.className = 'card';
    card.style.cursor = 'pointer';
    card.style.transition = 'transform .14s';
    card.addEventListener('click', ()=>openDoc(doc.id));
    card.addEventListener('mousedown', ()=>card.style.transform='scale(.98)');
    card.addEventListener('mouseup', ()=>card.style.transform='');

    card.innerHTML = `
      <div class="card-row" style="padding:14px;gap:12px;border-bottom:${isDone?'none':'1px solid var(--bd)'}">
        <div style="width:46px;height:46px;border-radius:12px;background:${doc.icoBg};border:2px solid ${isDone?'var(--glt)':'var(--bd)'};display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0">${doc.ico}</div>
        <div style="flex:1;min-width:0">
          <div style="font-size:14px;font-weight:700;color:var(--tx)">${doc.name}</div>
          <div style="font-size:12px;color:var(--t2);margin-top:3px">${langStr} · 更新: ${doc.updated}</div>
          ${doc.fileName?'<div style="margin-top:3px;font-size:11px;color:var(--blu)">📎 '+doc.fileName+'</div>':''}
          ${expWarn}
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex-shrink:0">
          <span class="bdg ${isDone?'bg':'ba'}">${isDone?(L.docConfirmed||'確認済'):(L.docUnconfirmed||'未確認')}</span>
          <span style="font-size:18px;color:var(--t3)">›</span>
        </div>
      </div>`;
    el.appendChild(card);
  });
}




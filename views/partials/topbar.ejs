<header class="h-14 flex items-center justify-between px-6 bg-white border-b border-slate-100 flex-shrink-0">
  <span class="text-sm font-semibold text-slate-700">GreenBridge</span>
  <div class="flex items-center gap-3">
    <span class="text-sm text-slate-500"><%= locals.profile?.full_name || locals.user?.email || '' %></span>
    <form action="/logout" method="POST">
      <button type="submit" class="text-xs text-slate-400 hover:text-red-500 transition-colors">ログアウト</button>
    </form>
  </div>
</header>

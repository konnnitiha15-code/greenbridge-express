<aside class="flex flex-col w-60 min-h-screen bg-slate-900 border-r border-slate-800 flex-shrink-0">
  <!-- ロゴ -->
  <div class="flex items-center gap-3 px-5 py-5 border-b border-slate-800">
    <div class="flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-600 flex-shrink-0">
      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364-.707.707M6.343 17.657l-.707.707m12.728 0-.707-.707M6.343 6.343l-.707-.707" />
      </svg>
    </div>
    <div>
      <p class="text-sm font-bold text-white leading-tight">GreenBridge</p>
      <p class="text-[10px] text-slate-500 leading-tight mt-0.5">技能実習生管理</p>
    </div>
  </div>

  <!-- ナビ -->
  <nav class="flex-1 px-3 py-4 space-y-0.5">
    <%
      const nav = [
        { href: '/dashboard', label: 'ダッシュボード', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
        { href: '/workers',   label: '従業員管理',     icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
        { href: '/documents', label: '書類管理',       icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
        { href: '/companies', label: '会社管理',       icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
        { href: '/settings',  label: '設定・権限',     icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
      ]
      const current = locals.currentPath || ''
    %>
    <% nav.forEach(item => { %>
      <% const isActive = item.href === '/dashboard' ? current === '/dashboard' : current.startsWith(item.href) %>
      <a href="<%= item.href %>" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors <%= isActive ? 'bg-emerald-600/20 text-emerald-400' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800' %>">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= item.icon %>" />
        </svg>
        <%= item.label %>
      </a>
    <% }) %>
  </nav>

  <div class="px-3 py-4 border-t border-slate-800">
    <p class="text-[10px] text-slate-600 px-3">© 2025 GreenBridge</p>
  </div>
</aside>

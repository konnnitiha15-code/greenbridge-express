<%- include('../partials/head') %>
<body class="flex h-screen overflow-hidden bg-slate-50">
  <%- include('../partials/sidebar', { currentPath: '/workers' }) %>
  <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
    <%- include('../partials/topbar') %>
    <main class="flex-1 overflow-y-auto p-6">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-xl font-bold text-slate-900">従業員管理</h1>
          <p class="text-sm text-slate-500 mt-0.5"><%= workers.length %>名が登録されています</p>
        </div>
        <a href="/workers/new" class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          新規登録
        </a>
      </div>
      <%- include('../partials/flash') %>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50">
              <th class="text-left px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">氏名</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider hidden md:table-cell">言語</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider hidden lg:table-cell">職種</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider hidden lg:table-cell">在留期限</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">ステータス</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (!workers.length) { %>
              <tr><td colspan="6" class="text-center py-12 text-slate-400">従業員が登録されていません</td></tr>
            <% } %>
            <% const langLabel = { vi:'🇻🇳 ベトナム語', id:'🇮🇩 インドネシア語', tl:'🇵🇭 フィリピン語', my:'🇲🇲 ミャンマー語', zh:'🇨🇳 中国語', km:'🇰🇭 クメール語', ja:'🇯🇵 日本語' } %>
            <% const statusColor = { active:'bg-emerald-50 text-emerald-700 border-emerald-200', inactive:'bg-slate-50 text-slate-500 border-slate-200', issue:'bg-red-50 text-red-700 border-red-200' } %>
            <% const statusLabel = { active:'在籍中', inactive:'退職済み', issue:'要対応' } %>
            <% workers.forEach(w => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-5 py-3.5">
                  <p class="font-medium text-slate-900"><%= w.name %></p>
                  <% if (w.name_kana) { %><p class="text-xs text-slate-400 mt-0.5"><%= w.name_kana %></p><% } %>
                </td>
                <td class="px-4 py-3.5 hidden md:table-cell text-xs text-slate-500"><%= langLabel[w.language] || '—' %></td>
                <td class="px-4 py-3.5 hidden lg:table-cell text-slate-600"><%= w.job_title || '—' %></td>
                <td class="px-4 py-3.5 hidden lg:table-cell text-xs text-slate-500"><%= w.residence_expire || '—' %></td>
                <td class="px-4 py-3.5">
                  <span class="inline-flex text-xs font-medium px-2 py-0.5 rounded-full border <%= statusColor[w.status] || '' %>">
                    <%= statusLabel[w.status] || w.status %>
                  </span>
                </td>
                <td class="px-4 py-3.5 text-right">
                  <a href="/workers/<%= w.id %>" class="text-slate-400 hover:text-slate-600">
                    <svg class="w-4 h-4 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>

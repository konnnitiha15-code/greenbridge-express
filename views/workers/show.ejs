<%- include('../partials/head') %>
<body class="flex h-screen overflow-hidden bg-slate-50">
  <%- include('../partials/sidebar', { currentPath: '/workers' }) %>
  <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
    <%- include('../partials/topbar') %>
    <main class="flex-1 overflow-y-auto p-6">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-xl font-bold text-slate-900"><%= worker.name %></h1>
          <p class="text-sm text-slate-500 mt-0.5"><%= worker.job_title || '' %></p>
        </div>
        <div class="flex gap-2">
          <a href="/workers/<%= worker.id %>/edit" class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 text-slate-600 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
            編集
          </a>
          <form action="/workers/<%= worker.id %>/delete" method="POST" onsubmit="return confirm('削除しますか？')">
            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 border border-red-200 text-red-600 text-sm font-medium rounded-lg hover:bg-red-50 transition-colors">削除</button>
          </form>
        </div>
      </div>
      <%- include('../partials/flash') %>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 max-w-5xl">
        <div class="lg:col-span-2 space-y-4">
          <% const section = (title, fields) => { %>
          <!-- section rendered inline -->
          <% } %>

          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">基本情報</h3>
            <dl class="grid grid-cols-2 gap-4">
              <% [['氏名（カナ）', worker.name_kana], ['国籍', worker.nationality], ['生年月日', worker.date_of_birth], ['性別', worker.gender === 'male' ? '男性' : worker.gender === 'female' ? '女性' : worker.gender], ['住所', worker.address], ['緊急連絡先', worker.emergency_contact]].forEach(([l,v]) => { %>
                <div>
                  <dt class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5"><%= l %></dt>
                  <dd class="text-sm text-slate-900"><%= v || '—' %></dd>
                </div>
              <% }) %>
            </dl>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">在留情報</h3>
            <dl class="grid grid-cols-2 gap-4">
              <% [['在留資格', worker.visa_type], ['在留カード番号', worker.residence_card], ['在留期限', worker.residence_expire], ['入国日', worker.entry_date], ['契約終了日', worker.contract_end], ['パスポート番号', worker.passport_number], ['パスポート期限', worker.passport_expire]].forEach(([l,v]) => { %>
                <div>
                  <dt class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5"><%= l %></dt>
                  <dd class="text-sm text-slate-900"><%= v || '—' %></dd>
                </div>
              <% }) %>
            </dl>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4">勤務情報</h3>
            <dl class="grid grid-cols-2 gap-4">
              <% [['職種', worker.job_title], ['部署', worker.department], ['担当者', worker.supervisor], ['給与', worker.salary], ['保険', worker.insurance]].forEach(([l,v]) => { %>
                <div>
                  <dt class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5"><%= l %></dt>
                  <dd class="text-sm text-slate-900"><%= v || '—' %></dd>
                </div>
              <% }) %>
            </dl>
          </div>
        </div>

        <div>
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold text-slate-700">関連書類</h3>
              <a href="/documents/upload?worker=<%= worker.id %>" class="text-xs text-emerald-600 hover:underline">追加</a>
            </div>
            <% if (!documents.length) { %>
              <p class="text-xs text-slate-400">書類がありません</p>
            <% } else { %>
              <ul class="space-y-2">
                <% documents.forEach(d => { %>
                  <li>
                    <a href="/documents/<%= d.id %>" class="flex items-center gap-2 text-xs font-medium text-slate-700 hover:text-emerald-600">
                      <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                      <span class="truncate"><%= d.name %></span>
                    </a>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>

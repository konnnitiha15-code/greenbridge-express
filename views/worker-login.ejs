<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<meta name="theme-color" content="#00b050">
<title>GreenBridge — ログイン</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;font-family:'Noto Sans JP',sans-serif;background:#f0f2f6}
body{display:flex;flex-direction:column;align-items:center;justify-content:center;
     padding:20px;min-height:100dvh}
input,button{font-family:inherit}

.card{
  background:#fff;
  border-radius:20px;
  border:1.5px solid #d8dce6;
  box-shadow:0 4px 24px rgba(0,0,0,.08);
  width:100%;max-width:400px;
  overflow:hidden;
}

/* ヘッダー */
.hdr{
  background:#00b050;
  padding:28px 24px 24px;
  text-align:center;
}
.logo{
  width:52px;height:52px;border-radius:14px;
  background:rgba(255,255,255,.2);
  border:2px solid rgba(255,255,255,.4);
  display:inline-flex;align-items:center;justify-content:center;
  font-size:26px;margin-bottom:14px;
}
.hdr-title{font-size:22px;font-weight:700;color:#fff;letter-spacing:-.3px}
.hdr-sub{font-size:13px;color:rgba(255,255,255,.8);margin-top:4px}

/* フォーム */
.body{padding:28px 24px}

.alert{
  background:#fff0f0;border:1.5px solid #fca5a5;
  border-radius:10px;padding:11px 14px;
  font-size:13px;color:#e53e3e;margin-bottom:18px;
}

.field{margin-bottom:18px}
.label{
  display:block;font-size:11.5px;font-weight:700;
  color:#4a5568;text-transform:uppercase;
  letter-spacing:.05em;margin-bottom:6px;
}
.inp{
  width:100%;padding:13px 15px;
  border:2px solid #d8dce6;border-radius:11px;
  font-size:15px;color:#0d1117;background:#fafbfd;
  outline:none;transition:border-color .15s;
  -webkit-appearance:none;
}
.inp:focus{border-color:#00b050;background:#fff}

.btn-login{
  width:100%;padding:15px;
  background:#00b050;color:#fff;
  border:none;border-radius:11px;
  font-size:16px;font-weight:700;
  cursor:pointer;transition:all .14s;
  letter-spacing:.02em;
  -webkit-appearance:none;
}
.btn-login:active{transform:scale(.97);background:#009040}

/* フッター */
.ftr{
  text-align:center;margin-top:22px;
  font-size:12.5px;color:#8a94a8;
}
.ftr a{color:#00b050;text-decoration:none;font-weight:600}
</style>
</head>
<body>

<div class="card">
  <div class="hdr">
    <div class="logo">🌿</div>
    <div class="hdr-title">GreenBridge</div>
    <div class="hdr-sub">作業者ログイン</div>
  </div>

  <div class="body">
    <% if (locals.errorMsg) { %>
      <div class="alert"><%= errorMsg %></div>
    <% } %>

    <form method="POST" action="/worker/login">
      <div class="field">
        <label class="label" for="email">メールアドレス</label>
        <input class="inp" type="email" id="email" name="email"
          placeholder="example@company.com"
          autocomplete="email" inputmode="email" required>
      </div>

      <div class="field">
        <label class="label" for="password">パスワード</label>
        <input class="inp" type="password" id="password" name="password"
          placeholder="••••••••"
          autocomplete="current-password" required>
      </div>

      <button class="btn-login" type="submit">ログイン</button>
    </form>
  </div>
</div>

<div class="ftr">
  管理者の方は <a href="/login">管理者ログイン</a> をご利用ください
</div>

</body>
</html>

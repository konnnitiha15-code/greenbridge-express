<%- include('../partials/head') %>
<body class="flex h-screen overflow-hidden bg-slate-50">
  <%- include('../partials/sidebar', { currentPath: '/companies' }) %>
  <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
    <%- include('../partials/topbar') %>
    <main class="flex-1 overflow-y-auto p-6">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-xl font-bold text-slate-900">会社管理</h1>
          <p class="text-sm text-slate-500 mt-0.5"><%= companies.length %>社が登録されています</p>
        </div>
        <a href="/companies/new" class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          会社を追加
        </a>
      </div>
      <%- include('../partials/flash') %>
      <div class="grid gap-3">
        <% if (!companies.length) { %>
          <div class="text-center py-16 text-slate-400 bg-white rounded-xl border border-slate-200">会社が登録されていません</div>
        <% } %>
        <% companies.forEach(c => { %>
          <div class="flex items-center gap-4 bg-white rounded-xl border border-slate-200 p-4 hover:border-emerald-300 hover:shadow-sm transition-all">
            <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-slate-900"><%= c.name %></p>
              <% if (c.name_kana) { %><p class="text-xs text-slate-400 mt-0.5"><%= c.name_kana %></p><% } %>
              <% if (c.address) { %><p class="text-xs text-slate-400 mt-0.5 truncate"><%= c.address %></p><% } %>
            </div>
            <div class="text-right hidden sm:block">
              <% if (c.email) { %><p class="text-xs text-slate-400"><%= c.email %></p><% } %>
              <% if (c.phone) { %><p class="text-xs text-slate-400 mt-0.5"><%= c.phone %></p><% } %>
            </div>
            <a href="/companies/<%= c.id %>/edit" class="text-slate-400 hover:text-slate-600 ml-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
            </a>
          </div>
        <% }) %>
      </div>
    </main>
  </div>
</body>
</html>

<%- include('../partials/head') %>
<body class="flex h-screen overflow-hidden bg-slate-50">
  <%- include('../partials/sidebar', { currentPath: '/documents' }) %>
  <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
    <%- include('../partials/topbar') %>
    <main class="flex-1 overflow-y-auto p-6">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-xl font-bold text-slate-900"><%= doc.name %></h1>
          <p class="text-sm text-slate-500 mt-0.5"><%= categoryLabel[doc.category] %></p>
        </div>
        <div class="flex gap-2">
          <% if (doc.file_url) { %>
            <a href="<%= doc.file_url %>" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 text-slate-600 text-sm font-medium rounded-lg hover:bg-slate-50">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              ダウンロード
            </a>
          <% } %>
          <form action="/documents/<%= doc.id %>/delete" method="POST" onsubmit="return confirm('削除しますか？')">
            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 border border-red-200 text-red-600 text-sm font-medium rounded-lg hover:bg-red-50">削除</button>
          </form>
        </div>
      </div>
      <%- include('../partials/flash') %>

      <div class="max-w-2xl bg-white rounded-xl border border-slate-200 shadow-sm divide-y divide-slate-100">
        <% const rows = [['書類名', doc.name], ['カテゴリ', categoryLabel[doc.category]], ['対象従業員', doc.workers?.name || '会社共通'], ['発行日', doc.issue_date || '—'], ['有効期限', doc.expire_date || '—'], ['メモ', doc.notes || '—']] %>
        <% rows.forEach(([l,v]) => { %>
          <div class="flex gap-6 px-5 py-3.5">
            <dt class="w-28 flex-shrink-0 text-xs font-semibold text-slate-400 uppercase tracking-wider pt-0.5"><%= l %></dt>
            <dd class="flex-1 text-sm text-slate-900"><%= v %></dd>
          </div>
        <% }) %>
        <% if (doc.file_url) { %>
          <div class="flex gap-6 px-5 py-3.5">
            <dt class="w-28 flex-shrink-0 text-xs font-semibold text-slate-400 uppercase tracking-wider pt-0.5">ファイル</dt>
            <dd class="flex-1">
              <a href="<%= doc.file_url %>" target="_blank" class="text-sm text-emerald-600 hover:underline"><%= doc.file_name || 'ファイルを開く' %></a>
            </dd>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>

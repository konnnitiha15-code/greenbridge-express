<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>GreenBridge — 管理プラットフォーム</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=DM+Mono:wght@400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- ═══════════════════════════════════════════════════════════
     サーバー注入データ
════════════════════════════════════════════════════════════ -->
<script>
const WORKERS     = <%- JSON.stringify(workers) %>;
const DOCS        = <%- JSON.stringify(docs) %>;
const GB_USER     = <%- JSON.stringify(gbUser) %>;
const GB_COMPANY  = <%- JSON.stringify(companyName) %>;
</script>

<!-- ═══════════════════════════════════════════════════════════
     トースト・モーダル
════════════════════════════════════════════════════════════ -->
<div class="toasts" id="toasts"></div>
<div class="modal-bg" id="modal-bg" onclick="closeModal(event)">
  <div class="modal">
    <div class="modal-hdr">
      <div class="modal-title" id="modal-title">-</div>
      <button class="btn btn-sm" onclick="closeModal()">✕ 閉じる</button>
    </div>
    <div class="modal-body" id="modal-body"></div>
    <div class="modal-foot" id="modal-foot"></div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     アプリシェル
════════════════════════════════════════════════════════════ -->
<div class="app">

<!-- ─── サイドバー ────────────────────────────────────────── -->
<nav class="sidebar">
  <div class="sb-hdr">
    <div class="sb-logo">
      <div class="sb-lico"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 1.5L2 5.5v7L9 16.5l7-4v-7L9 1.5z" stroke="#fff" stroke-width="1.7" fill="none" stroke-linejoin="round"/><path d="M9 1.5v9M2 5.5l7 4 7-4" stroke="#fff" stroke-width="1.7" stroke-linejoin="round"/></svg></div>
      <div><div class="sb-brand">GreenBridge</div><div class="sb-bsub">現場管理プラットフォーム</div></div>
    </div>
  </div>
  <div class="sb-nav">
    <div class="sb-sec">メイン</div>
    <div class="sb-item on" id="nav-home" onclick="SP('home')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 7l6-6 6 6v7a1 1 0 01-1 1H3a1 1 0 01-1-1z" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linejoin="round"/><path d="M6 14v-5h4v5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      ホーム
    </div>
    <div class="sb-item" id="nav-chat" onclick="SP('chat')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1.5 3A1.5 1.5 0 013 1.5h10A1.5 1.5 0 0114.5 3v7A1.5 1.5 0 0113 11.5H9L6 14v-2.5H3A1.5 1.5 0 011.5 10V3z" stroke="currentColor" fill="none" stroke-width="1.4"/></svg>
      チャット
      <span class="sb-bdg" id="chat-bdg" style="display:none">0</span>
    </div>
    <div class="sb-item" id="nav-workers" onclick="SP('workers')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="5.5" r="3" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M2 14c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/></svg>
      実習生管理
    </div>
    <div class="sb-item" id="nav-docs" onclick="SP('docs')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="1" width="12" height="14" rx="2" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M5 5h6M5 8h6M5 11h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      書類・翻訳管理
    </div>
    <div class="sb-sec">現場管理</div>
    <div class="sb-item" id="nav-tasks" onclick="SP('tasks')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1.5" y="2" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M5 6l1.5 1.5L9 4M5 10l1.5 1.5L9 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      タスク管理
    </div>
    <div class="sb-item" id="nav-gchat" onclick="SP('gchat')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 3a1.5 1.5 0 011.5-1.5h6A1.5 1.5 0 0111 3v5a1.5 1.5 0 01-1.5 1.5H7L5 12V9.5H3.5A1.5 1.5 0 012 8V3z" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="M9 7h1.5A1.5 1.5 0 0112 8.5v3L10.5 13V11H9" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linejoin="round"/></svg>
      グループチャット
      <span class="sb-bdg g" id="gchat-bdg" style="display:none">0</span>
    </div>
    <div class="sb-item" id="nav-videos" onclick="SP('videos')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="3" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M11 6.5l4-2v7l-4-2V6.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" fill="none"/><path d="M4 8l2.5 1.5L4 11V8z" fill="currentColor" opacity=".7"/></svg>
      動画マニュアル
    </div>
    <div class="sb-item" id="nav-nippo" onclick="SP('nippo')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="1" width="12" height="14" rx="2" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M5 5h6M5 8h5M5 11h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="12" cy="12" r="3.5" fill="var(--gn)"/><path d="M10.5 12l1 1 2-2" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      日報・報告
    </div>
    <div class="sb-item" id="nav-shift" onclick="SP('shift')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="3" width="14" height="11" rx="2" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M5 1v4M11 1v4M1 7h14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      シフト管理
    </div>
    <div class="sb-item" id="nav-attend" onclick="SP('attend')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="5.5" r="2.5" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M2 13.5c0-2.8 2.2-4.5 5-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/><circle cx="12.5" cy="11.5" r="3" fill="var(--gn)"/><path d="M11 11.5l1 1 2-2" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      勤怠管理
    </div>
    <div class="sb-item" id="nav-roles" onclick="SP('roles')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1L2 4.5v7L8 15l6-3.5v-7L8 1z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/><path d="M5.5 8l2 2 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      権限管理
    </div>
    <div class="sb-sec">設定</div>
    <div class="sb-item" id="nav-settings" onclick="SP('settings')">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="2.5" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.6 3.6l1.4 1.4M11 11l1.4 1.4M3.6 12.4l1.4-1.4M11 5l1.4-1.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      設定
    </div>
  </div>
  <div class="sb-foot">
    <div class="sb-user" onclick="SP('settings')">
      <div class="sb-uav" id="sb-uav" style="background:#064e3b;color:#6ee7b7">
        <%= (profile?.full_name || gbUser?.email || '?')[0].toUpperCase() %>
      </div>
      <div style="flex:1;min-width:0">
        <div class="sb-uname"><%= profile?.full_name || gbUser?.email || 'ユーザー' %></div>
        <div class="sb-urole"><%= ({admin:'管理者',manager:'マネージャー',staff:'スタッフ'})[profile?.role] || profile?.role || 'スタッフ' %></div>
      </div>
      <% if (profile?.role === 'admin') { %>
      <span style="font-size:14px" title="管理者">👑</span>
      <% } %>
    </div>
  </div>
</nav>

<!-- ─── メインエリア ──────────────────────────────────────── -->
<div class="main">
  <div class="topbar">
    <!-- ハンバーガー（モバイル） -->
    <button class="hamburger" onclick="toggleSidebar()" title="メニュー">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="tb-title" id="tb-title">ホーム</div>
    <div class="tb-right">
      <% if (profile?.role === 'admin') { %>
      <span class="tb-pill admin">👑 管理者</span>
      <% } %>
      <span class="tb-pill live"><span class="pulse"></span> 同期中</span>
      <button class="tb-btn" onclick="showNotif()" title="通知 / Notifications">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1.5A5 5 0 003 6.5v3L2 11.5h12l-1-2v-3A5 5 0 008 1.5z" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M6.5 13a1.5 1.5 0 003 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <div class="tb-dot" id="notif-dot" style="display:none"></div>
      </button>
      <form action="/logout" method="POST" style="margin:0">
        <button class="btn btn-sm" type="submit">ログアウト</button>
      </form>
    </div>
  </div>

  <div class="body">

  <!-- ─── HOME ──────────────────────────────────────────── -->
  <div class="page on" id="page-home"><div class="pscroll">
    <!-- グリーティング -->
    <div class="home-header">
      <div>
        <h1 class="home-greeting">おはようございます、<%= (profile?.full_name||'ゲスト').split(/[\s　]/)[0] %>さん 👋</h1>
        <p class="home-sub" id="home-sub">読み込み中...</p>
      </div>
      <button class="btn btn-g" onclick="showExpireAlerts()">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1.5A4.5 4.5 0 002.5 6v2.5L1.5 10h11l-1-1.5V6A4.5 4.5 0 007 1.5z" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="M5.5 11.5a1.5 1.5 0 003 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        期限アラート
      </button>
    </div>

    <!-- KPI -->
    <div class="kpi-row">
      <div class="kpi gn" onclick="SP('workers')" style="cursor:pointer">
        <div class="kpi-top">
          <div class="kpi-ico" style="background:var(--gbg)">👥</div>
          <span class="badge bg" id="kpi-workers-sub">0名</span>
        </div>
        <div class="kpi-val" id="kpi-workers-val">0</div>
        <div class="kpi-lbl">総実習生数</div>
        <div class="kpi-sub kpi-sub--gn" id="kpi-workers-detail">-</div>
      </div>
      <div class="kpi bl" onclick="SP('chat')" style="cursor:pointer">
        <div class="kpi-top">
          <div class="kpi-ico" style="background:var(--bbg)">💬</div>
          <span class="badge br" id="unread-kpi">0件</span>
        </div>
        <div class="kpi-val" id="unread-val">0</div>
        <div class="kpi-lbl">未読メッセージ</div>
        <div class="kpi-sub kpi-sub--muted">チャットを確認</div>
      </div>
      <div class="kpi am" onclick="SP('docs')" style="cursor:pointer">
        <div class="kpi-top">
          <div class="kpi-ico" style="background:var(--abg)">📄</div>
          <span class="badge bb">書類</span>
        </div>
        <div class="kpi-val" id="doc-kpi-val">0</div>
        <div class="kpi-lbl">登録書類数</div>
        <div class="kpi-sub kpi-sub--muted" id="doc-kpi-sub">-</div>
      </div>
      <div class="kpi rd" onclick="showExpireAlerts()" style="cursor:pointer">
        <div class="kpi-top">
          <div class="kpi-ico" style="background:var(--rbg)">⏰</div>
          <span class="badge br" id="expire-kpi-badge">0件</span>
        </div>
        <div class="kpi-val" id="expire-kpi-val">0</div>
        <div class="kpi-lbl">在留期限通知</div>
        <div class="kpi-sub kpi-sub--muted" id="expire-kpi-sub">クリックで詳細</div>
      </div>
    </div>

    <!-- 勤怠KPIカード（管理者向け） -->
    <% if (profile?.role === 'admin') { %>
    <div class="kpi-row" style="margin-top:0">
      <div class="kpi gn" onclick="SP('attend')" style="cursor:pointer">
        <div class="kpi-top">
          <div class="kpi-ico" style="background:var(--gbg)">✅</div>
          <span class="badge bg">本日</span>
        </div>
        <div class="kpi-val" id="home-att-present">-</div>
        <div class="kpi-lbl">本日の出勤人数</div>
        <div class="kpi-sub kpi-sub--gn">クリックで勤怠管理へ</div>
      </div>
      <div class="kpi rd" onclick="SP('attend')" style="cursor:pointer">
        <div class="kpi-top">
          <div class="kpi-ico" style="background:var(--rbg)">❌</div>
          <span class="badge br">本日</span>
        </div>
        <div class="kpi-val" id="home-att-absent">-</div>
        <div class="kpi-lbl">未出勤人数</div>
        <div class="kpi-sub kpi-sub--muted">欠勤・未登録</div>
      </div>
      <div class="kpi am" onclick="SP('attend')" style="cursor:pointer">
        <div class="kpi-top">
          <div class="kpi-ico" style="background:var(--abg)">⏰</div>
          <span class="badge ba">本日</span>
        </div>
        <div class="kpi-val" id="home-att-late">-</div>
        <div class="kpi-lbl">遅刻人数</div>
        <div class="kpi-sub kpi-sub--muted">本日の遅刻者</div>
      </div>
      <div class="kpi bl" onclick="SP('attend')" style="cursor:pointer">
        <div class="kpi-top">
          <div class="kpi-ico" style="background:var(--bbg)">📊</div>
          <span class="badge bb">本日</span>
        </div>
        <div class="kpi-val" id="home-att-rate">-%</div>
        <div class="kpi-lbl">出勤率</div>
        <div class="kpi-sub kpi-sub--muted">出勤＋遅刻含む</div>
      </div>
    </div>
    <% } %>

    <!-- メインコンテンツグリッド -->
    <div class="home-grid">
      <div class="card">
        <div class="card-hdr">
          <span class="card-title">⏰ 在留期限アラート</span>
          <button class="btn btn-sm" onclick="SP('workers')">一覧 →</button>
        </div>
        <div id="home-expire-list" class="card-body">
          <div class="empty-state" style="padding:24px 0">
            <p>期限切れ・期限間近の実習生がいません ✅</p>
          </div>
        </div>
      </div>
      <div class="home-side">
        <% if (profile?.role === 'admin') { %>
        <div class="card">
          <div class="card-hdr">
            <span class="card-title">🕐 最近の勤怠記録</span>
            <button class="btn btn-sm" onclick="SP('attend')">一覧 →</button>
          </div>
          <div id="home-att-recent" class="card-body">
            <div class="skeleton" style="height:40px;margin-bottom:8px"></div>
            <div class="skeleton" style="height:40px;width:90%"></div>
          </div>
        </div>
        <% } %>
        <div class="card">
          <div class="card-hdr"><span class="card-title">📊 ステータス</span></div>
          <div id="home-status-list" class="card-body card-list">
            <div class="skeleton" style="height:18px;margin-bottom:8px"></div>
            <div class="skeleton" style="height:18px;width:70%"></div>
          </div>
        </div>
        <div class="card">
          <div class="card-hdr"><span class="card-title">🌏 国籍分布</span></div>
          <div id="home-lang-list" class="card-body card-list">
            <div class="skeleton" style="height:18px;margin-bottom:8px"></div>
            <div class="skeleton" style="height:18px;width:80%"></div>
          </div>
        </div>
      </div>
    </div>
  </div></div>

  <!-- ─── CHAT ──────────────────────────────────────────── -->
  <div class="page" id="page-chat">
    <div class="two-panel">
      <div class="left-panel" style="width:280px">
        <div class="panel-hdr"><span class="panel-title">メッセージ</span><div style="display:flex;align-items:center;gap:4px;font-size:11.5px;color:var(--gn)"><span class="pulse"></span>同期中</div></div>
        <div class="panel-search"><svg width="13" height="13" viewBox="0 0 13 13" fill="none"><circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.4"/><path d="M9 9l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><input placeholder="実習生を検索..." oninput="renderCL(this.value)"></div>
        <div class="panel-list" id="cl-items"></div>
      </div>
      <div class="chat-wall">
        <div class="chat-welcome" id="chat-welcome">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none"><path d="M5 9a4 4 0 014-4h26a4 4 0 014 4v18a4 4 0 01-4 4H25l-8 6v-6H9a4 4 0 01-4-4V9z" stroke="var(--gn)" stroke-width="2" fill="none"/></svg>
          <div style="font-size:16px;font-weight:700;color:var(--t2)">実習生を選んでください</div>
          <div style="font-size:13px;color:var(--t3)">左リストをクリックするとチャットが開きます</div>
        </div>
        <div id="chat-active" style="display:none;flex:1;flex-direction:column;overflow:hidden">
          <div class="chat-topbar">
            <div class="chat-av" id="ch-av"></div>
            <div style="flex:1;min-width:0"><div class="chat-name" id="ch-name">-</div><div class="chat-sub" id="ch-sub">-</div></div>
            <div style="display:flex;gap:6px"><button class="btn btn-g btn-sm" onclick="doApprove()">✓ 承認</button><button class="btn btn-sm" onclick="openWorkerProfile()">👤 詳細</button></div>
          </div>
          <div class="msgs" id="msgs"></div>
          <div class="chat-inp">
            <div class="chat-toolbar">
              <span style="font-size:12px;color:var(--t3)">翻訳先:</span>
              <select class="lang-sel" id="tgt-lang"><option value="vi">🇻🇳 ベトナム語</option><option value="id">🇮🇩 インドネシア語</option><option value="tl">🇵🇭 フィリピン語</option><option value="zh">🇨🇳 中国語</option><option value="my">🇲🇲 ミャンマー語</option></select>
              <div class="ai-pill"><svg width="11" height="11" viewBox="0 0 11 11" fill="none"><circle cx="5.5" cy="5.5" r="4.5" stroke="currentColor" stroke-width="1.1"/><path d="M3.5 5.5l1.5 1.5 2.5-2.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>AI翻訳オン</div>
              <button class="quick-btn" onclick="insertQuick('お疲れ様です。')">定型: お疲れ様</button>
              <button class="quick-btn" onclick="insertQuick('確認しました。')">定型: 確認</button>
              <button class="quick-btn" onclick="insertQuick('申請を承認しました。')">定型: 承認</button>
            </div>
            <div class="inp-row">
              <textarea class="msg-inp" id="msg-inp" rows="1" placeholder="日本語で入力 → AIが実習生の言語に自動翻訳して送信" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMsg()}" oninput="autoH(this)"></textarea>
              <button class="send-btn" id="send-btn" onclick="sendMsg()"><svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M2 7.5L14 1.5l-5 12-2.5-4.5L2 7.5z" fill="white"/></svg></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── WORKERS ────────────────────────────────────────── -->
  <div class="page" id="page-workers">
    <div class="two-panel">
      <div class="left-panel" style="width:280px">
        <div class="panel-hdr">
          <span class="panel-title">実習生管理</span>
          <button class="btn btn-g btn-sm" id="add-worker-btn" onclick="openAddWorker()">+ 追加</button>
        </div>
        <div class="panel-search"><svg width="13" height="13" viewBox="0 0 13 13" fill="none"><circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.4"/><path d="M9 9l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><input placeholder="名前・職種で検索..." oninput="renderWL(this.value)"></div>
        <div class="panel-filters" id="wl-filters">
          <div class="fc on" onclick="setWF('all',this)">すべて</div>
          <div class="fc" onclick="setWF('active',this)">在籍中</div>
          <div class="fc" onclick="setWF('issue',this)">要確認</div>
          <div class="fc" onclick="setWF('vi',this)">🇻🇳</div>

          <div style="display:flex;align-items:center;gap:8px">
            <div style="flex:1;height:6px;background:var(--s2);border-radius:99px;overflow:hidden">
              <div id="task-progress-bar" style="width:0%;height:100%;background:var(--gn);border-radius:99px;transition:width .3s"></div>
            </div>
            <span id="task-progress-pct" style="font-size:12.5px;font-weight:600">0%</span>
          </div>
        </div>
      </div>
      <div class="kanban-board" id="kanban-board"></div>
    </div>
  </div>

  <!-- ─── GROUP CHAT ────────────────────────────────────── -->
  <div class="page" id="page-gchat">
    <div class="two-panel">
      <div class="left-panel" style="width:280px">
        <div class="panel-hdr">
          <span class="panel-title">グループチャット</span>
          <button class="btn btn-g btn-sm" id="create-group-btn" onclick="openCreateGroup()">+ 作成</button>
        </div>
        <div class="panel-search"><svg width="13" height="13" viewBox="0 0 13 13" fill="none"><circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.4"/><path d="M9 9l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><input placeholder="グループを検索..."></div>
        <div class="panel-list" id="gc-list"></div>
      </div>
      <div class="chat-wall">
        <div class="chat-welcome" id="gchat-welcome">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none"><path d="M4 8a4 4 0 014-4h16a4 4 0 014 4v14a4 4 0 01-4 4H17l-6 5v-5H8a4 4 0 01-4-4V8z" stroke="var(--gn)" stroke-width="2" fill="none"/><path d="M22 18h14a4 4 0 014 4v10a4 4 0 01-4 4h-4v5l-6-5h-4a4 4 0 01-4-4v-2" stroke="var(--gn)" stroke-width="2" fill="none"/></svg>
          <div style="font-size:16px;font-weight:700;color:var(--t2)">グループを選んでください</div>
        </div>
        <div id="gchat-active" style="display:none;flex:1;flex-direction:column;overflow:hidden">
          <div class="chat-topbar">
            <div style="width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0" id="gch-ico"></div>
            <div style="flex:1;min-width:0"><div class="chat-name" id="gch-name">-</div><div class="chat-sub" id="gch-sub">-</div></div>
            <div style="display:flex;gap:6px">
              <button class="btn btn-sm" id="manage-group-btn" onclick="openManageGroup()">👥 メンバー管理</button>
              <button class="btn btn-sm" id="edit-group-btn" onclick="openEditGroup()">⚙️ 設定</button>
            </div>
          </div>
          <div class="msgs" id="gchat-msgs" style="background:#e8ede4"></div>
          <div class="chat-inp">
            <div class="chat-toolbar">
              <span style="font-size:12px;color:var(--t3)">一斉翻訳:</span>
              <select class="lang-sel" id="gchat-lang"><option value="all">全言語に自動翻訳</option><option value="vi">🇻🇳 ベトナム語のみ</option><option value="id">🇮🇩 インドネシア語のみ</option></select>
              <div class="ai-pill"><span class="pulse"></span>一斉翻訳オン</div>
              <button class="quick-btn" onclick="insertGQuick('本日の作業内容を確認してください。')">作業確認</button>
              <button class="quick-btn" onclick="insertGQuick('安全確認をお願いします。')">安全確認</button>
              <button class="quick-btn" onclick="insertGQuick('お疲れ様でした。')">お疲れ様</button>
            </div>
            <div class="inp-row">
              <textarea class="msg-inp" id="gchat-inp" rows="1" placeholder="メッセージを入力 → 全メンバーの言語に一斉翻訳して送信" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendGChat()}" oninput="autoH(this)"></textarea>
              <button class="send-btn" onclick="sendGChat()"><svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M2 7.5L14 1.5l-5 12-2.5-4.5L2 7.5z" fill="white"/></svg></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── VIDEOS ────────────────────────────────────────── -->
  <div class="page" id="page-videos">

          <svg width="44" height="44" viewBox="0 0 44 44" fill="none"><circle cx="22" cy="14" r="9" stroke="currentColor" stroke-width="2" fill="none"/><path d="M5 40c0-9.4 7.6-17 17-17s17 7.6 17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
          <div style="font-size:16px;font-weight:700">実習生を選んでください</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── DOCS ──────────────────────────────────────────── -->
  <div class="page" id="page-docs">
    <div class="two-panel">
      <!-- 左パネル: フィルタ + 書類リスト -->
      <div class="left-panel" style="width:300px;display:flex;flex-direction:column">
        <div class="panel-hdr">
          <span class="panel-title">書類管理</span>
          <button class="btn btn-g btn-sm" id="add-doc-btn" onclick="openAddDoc()">+ 追加</button>
        </div>
        <!-- 検索 -->
        <div class="panel-search">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.4"/><path d="M9 9l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>

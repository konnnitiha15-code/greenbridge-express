        <!-- カテゴリフィルタ -->
        <div id="doc-cat-filters" style="padding:7px 10px;border-bottom:1px solid var(--bd);display:flex;gap:5px;overflow-x:auto;flex-wrap:nowrap;scrollbar-width:none;-webkit-overflow-scrolling:touch">
          <div class="fc on" onclick="setDocCat('all',this)" style="white-space:nowrap;flex-shrink:0">すべて</div>
          <div class="fc" onclick="setDocCat('contract',this)" style="white-space:nowrap;flex-shrink:0">📋 契約</div>
          <div class="fc" onclick="setDocCat('visa',this)" style="white-space:nowrap;flex-shrink:0">🪪 在留</div>
          <div class="fc" onclick="setDocCat('passport',this)" style="white-space:nowrap;flex-shrink:0">📘 旅券</div>
          <div class="fc" onclick="setDocCat('insurance',this)" style="white-space:nowrap;flex-shrink:0">🏥 保険</div>
          <div class="fc" onclick="setDocCat('salary',this)" style="white-space:nowrap;flex-shrink:0">💴 給与</div>
          <div class="fc" onclick="setDocCat('safety',this)" style="white-space:nowrap;flex-shrink:0">📒 安全</div>
          <div class="fc" onclick="setDocCat('technical_intern',this)" style="white-space:nowrap;flex-shrink:0">🏭 技実</div>
          <div class="fc" onclick="setDocCat('specified_skilled',this)" style="white-space:nowrap;flex-shrink:0">⭐ 特技</div>
          <div class="fc" onclick="setDocCat('tax',this)" style="white-space:nowrap;flex-shrink:0">🧾 税務</div>
          <div class="fc" onclick="setDocCat('other',this)" style="white-space:nowrap;flex-shrink:0">📄 その他</div>
        </div>
        <!-- 従業員・ステータスフィルタ -->
        <div style="padding:7px 10px;border-bottom:1px solid var(--bd);display:flex;gap:5px">
          <select id="doc-worker-filter" class="form-inp" style="flex:1;font-size:11.5px;padding:5px 6px;min-width:0" onchange="filterDocs()">
            <option value="">👤 全従業員</option>
          </select>
          <select id="doc-status-filter" class="form-inp" style="flex:1;font-size:11.5px;padding:5px 6px;min-width:0" onchange="filterDocs()">
            <option value="">🔖 全状態</option>
            <option value="active">✅ 有効</option>
            <option value="expiring">⚠️ 期限間近</option>
            <option value="expired">❌ 期限切れ</option>
            <option value="nofile">📭 未添付</option>
          </select>
        </div>
        <!-- 件数表示 -->
        <div style="padding:5px 12px;font-size:11px;color:var(--t3);border-bottom:1px solid var(--bd);background:var(--bg2)">
          <span id="doc-count-label">0件</span>
        </div>
        <!-- 書類リスト -->
        <div class="panel-list" id="dl-items"></div>
      </div>
      <!-- 右パネル: 書類詳細（既存のまま） -->
      <div style="flex:1;display:flex;flex-direction:column;overflow:hidden" id="dd-panel">
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:12px;color:var(--t3);background:var(--bg)">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none"><rect x="7" y="3" width="30" height="38" rx="4" stroke="currentColor" stroke-width="2" fill="none"/><path d="M13 13h18M13 21h18M13 29h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <div style="font-size:16px;font-weight:700">書類を選んでください</div>
          <div style="font-size:13px;color:var(--t3)">左リストから書類を選択してください</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── TASKS (KANBAN) ────────────────────────────────── -->
  <div class="page" id="page-tasks">
    <div class="kanban-wrap">
      <div class="kanban-side">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2px">
          <div style="font-size:14px;font-weight:700;color:var(--tx)">タスク管理</div>
          <button class="btn btn-g btn-sm" id="add-task-btn" onclick="openAddTask()">+ 追加</button>
        </div>

        <!-- 期間フィルタ -->
        <div style="display:flex;gap:5px;margin-bottom:4px">
          <button class="btn btn-xs" style="flex:1;justify-content:center" onclick="setTaskMode('all')">すべて</button>
          <button class="btn btn-xs" style="flex:1;justify-content:center" onclick="setTaskMode('month')">月別</button>
        </div>

        <!-- 月ナビ -->
        <div id="task-month-nav" style="display:flex;align-items:center;gap:4px">
          <button class="btn btn-xs" style="padding:4px 8px" onclick="taskPrevMonth()">←</button>
          <div id="task-month-title" style="flex:1;text-align:center;font-size:12.5px;font-weight:700">すべてのタスク</div>
          <button class="btn btn-xs" style="padding:4px 8px" onclick="taskNextMonth()">→</button>
        </div>

        <!-- 完了率 -->
        <div style="border-top:1px solid var(--bd);padding-top:10px;margin-top:4px">

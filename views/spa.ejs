<script>
  window.GB_REALTIME_CONFIG = <%- JSON.stringify(realtimeConfig || {}) %>;
</script>
<script src="/js/services/storage.js"></script>
<script src="/js/services/realtime.js"></script>
<script src="/js/services/push-client.js"></script>
<script src="/js/app.js?v=20260529-nippo2"></script>
<script>
  // PWA + Web Push 初期化（SW登録のみ。購読は設定タブのトグルから明示的に有効化）
  if (window.GBPush) {
    window.addEventListener('load', () => {
      GBPush.init().catch(()=>{});
      renderAdminNotif();
    });
  }

  async function renderAdminNotif() {
    const btn = document.getElementById('admin-notif-toggle');
    const lbl = document.getElementById('admin-notif-status');
    if (!btn) return;
    if (!window.GBPush || !GBPush.isSupported()) {
      btn.disabled = true; btn.textContent = '非対応';
      if (lbl) lbl.textContent = 'このブラウザは非対応';
      return;
    }
    const st = await GBPush.getStatus();
    if (st.permission === 'denied') {
      btn.disabled = true; btn.textContent = 'ブロック中';
      if (lbl) lbl.textContent = 'ブラウザ設定で通知が拒否されています';
      return;
    }
    btn.disabled = false;
    btn.textContent = st.subscribed ? '無効化' : '有効化';
    if (lbl) lbl.textContent = st.subscribed ? '✅ 受信中' : '受信していません';
  }

  window.adminToggleNotif = async function () {
    try {
      const st = await GBPush.getStatus();
      if (st.subscribed) {
        await GBPush.disable();
        if (typeof toast === 'function') toast('通知無効化', 'プッシュ通知を停止しました', 'g');
      } else {
        await GBPush.enable();
        if (typeof toast === 'function') toast('通知有効化', 'プッシュ通知が届くようになりました', 'g');
      }
      renderAdminNotif();
    } catch (e) {
      alert(e.message || '通知設定の変更に失敗しました');
    }
  };

  window.adminTestNotif = async function () {
    try {
      const r = await GBPush.test();
      if (!r.ok) alert('テスト送信失敗: ' + (r.error || 'unknown'));
    } catch (e) { alert(e.message); }
  };
</script>


# Supabase 設定（Supabase Dashboard > Project Settings > API で確認）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# セッション署名キー（任意の文字列）
SESSION_SECRET=your-secret-string

# サーバーポート（省略時は3000）
PORT=3000

# Web Push (VAPID) — `node -e "console.log(require('web-push').generateVAPIDKeys())"` で生成
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 翻訳サービス（mymemory|google|deepl|anthropic|openai）省略時 mymemory
TRANSLATION_PROVIDER=mymemory
# MyMemory: メール設定で無料枠の上限が増える（任意）
MYMEMORY_EMAIL=

# AIアシスタントの意図解析エンジン（internal|anthropic|openai）省略時 internal=ルールベース（外部API不要）
# anthropic/openai を指定するとキー設定時のみLLMで意図解析（質問文のみ送信・従業員データは送らない）。失敗時は自動でルールベースに戻る。
AI_PROVIDER=internal
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

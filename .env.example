# Supabase 設定（Supabase Dashboard > Project Settings > API で確認）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# セッション署名キー（任意の文字列）
SESSION_SECRET=your-secret-string

# サーバーポート（省略時は3000）
PORT=3000

# Web Push (VAPID) — `node -e "console.log(require('web-push').generateVAPIDKeys())"` で生成
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
